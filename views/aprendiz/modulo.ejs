<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css?v=14">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
</head>
<body>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Aprendiz' }) %>

  <nav class="sidebar">
    <% locals.currentPath = '/aprendiz'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'aprendiz' } }) %>
  </nav>

  <main class="main">
    <a href="/aprendiz" class="btn btn-ghost mb-16">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Volver a la Ruta
    </a>

    <%
      // El progreso del módulo solo cuenta actividades visibles: las que el
      // instructor aún no activó (p. ej. la evaluación de cierre) no cuentan
      // como pendientes, solo se muestran bloqueadas más abajo.
      const actividadesVisibles = actividades.filter(a => a.visible);
      let totalActs = actividadesVisibles.length;
      let aprobadas = 0;
      actividadesVisibles.forEach(a => {
        const ent = entregaMap[a._id.toString()];
        if (ent && ent.estado === 'Aprobado') aprobadas++;
      });
      let pctModulo = totalActs > 0 ? Math.round((aprobadas / totalActs) * 100) : 0;
    %>

    <!-- Hero Banner Versión 2 (Figma) -->
    <div class="modulo-hero-v2">
      <div class="modulo-hero-content">
        <div class="modulo-hero-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          Módulo de Especialidad
        </div>
        <h1 class="modulo-hero-title"><%= modulo.nombre %></h1>
        <p class="modulo-hero-desc"><%= modulo.descripcion %></p>
      </div>

      <div class="modulo-progress-gauge">
        <div class="modulo-gauge-pct"><%= pctModulo %>%</div>
        <div class="modulo-gauge-label">Progreso Módulo</div>
      </div>
    </div>

    <!-- Timeline de RAPs Versión 2 (Figma) -->
    <div class="path-container-v2">
      <% if (raps.length === 0) { %>
        <p class="text-muted">Este módulo aún no tiene RAPs asignados.</p>
      <% } else { %>
        <% 
          // Agrupar actividades por RAP
          const actPorRap = {};
          actividades.forEach(a => {
            if (!actPorRap[a.rap]) actPorRap[a.rap] = [];
            actPorRap[a.rap].push(a);
          });
        %>

        <% raps.forEach(r => { 
          const acts = actPorRap[r._id.toString()] || [];
        %>
          <div class="rap-node-v2">
            <div class="rap-title-v2">
              <span><%= r.nombre %></span>
            </div>
            
            <% if (acts.length === 0) { %>
              <div class="alert alert-warning" style="margin-left: 10px;">No hay actividades registradas en este RAP por el momento.</div>
            <% } else { %>
              <div>
                <% acts.forEach(act => {
                  const entrega = entregaMap[act._id.toString()];
                  let statusClass = 'status-pendiente';
                  let statusText = 'Pendiente';

                  if (entrega) {
                    if (entrega.estado === 'Entregado') { statusClass = 'status-entregado'; statusText = 'En revisión'; }
                    else if (entrega.estado === 'Aprobado') { statusClass = 'status-aprobado'; statusText = 'Aprobado'; }
                    else if (entrega.estado === 'Reprobado') { statusClass = 'status-reprobado'; statusText = 'Reprobado'; }
                  }
                %>
                  <% if (act.visible) { %><a href="/aprendiz/actividad/<%= act._id %>" class="act-card-v2"><% } else { %><div class="act-card-v2 act-card-locked" title="El instructor aún no habilitó esta actividad"><% } %>
                    <div class="act-info-v2">
                      <div class="act-icon-v2 <%= act.tipo %>">
                        <% if (act.tipo === 'blog') { %>
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
                        <% } else if (act.tipo === 'juego') { %>
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><rect x="2" y="6" width="20" height="12" rx="2"/></svg>
                        <% } else { %>
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <% } %>
                      </div>
                      <div>
                        <div class="act-meta-v2"><%= act.momentoPedagogico %></div>
                        <div class="act-title-v2"><%= act.titulo %></div>
                      </div>
                    </div>
                    <% if (!act.visible) { %>
                      <div class="status-badge-v2 status-bloqueado" style="display: inline-flex; align-items: center; gap: 4px;">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>Bloqueada</span>
                      </div>
                    <% } else { %>
                      <div class="status-badge-v2 <%= statusClass %>" style="display: inline-flex; align-items: center; gap: 4px;">
                        <% if (entrega && entrega.estado === 'Aprobado') { %>
                          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <% } else if (entrega && entrega.estado === 'Reprobado') { %>
                          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <% } else if (entrega && entrega.estado === 'Entregado') { %>
                          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <% } else { %>
                          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/></svg>
                        <% } %>
                        <span><%= statusText %></span>
                      </div>
                    <% } %>
                  <% if (act.visible) { %></a><% } else { %></div><% } %>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>

