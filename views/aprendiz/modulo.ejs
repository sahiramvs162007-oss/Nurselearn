<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Aprendiz' }) %>

  <nav class="sidebar">
    <% locals.currentPath = '/aprendiz'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'aprendiz' } }) %>
  </nav>

  <main class="main">
    <a href="/aprendiz" class="btn btn-ghost mb-16">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Volver a la Ruta
    </a>

    <%
      let totalActs = actividades.length;
      let aprobadas = 0;
      actividades.forEach(a => {
        const ent = entregaMap[a._id.toString()];
        if (ent && ent.estado === 'Aprobado') aprobadas++;
      });
      let pctModulo = totalActs > 0 ? Math.round((aprobadas / totalActs) * 100) : 0;
    %>

    <!-- Hero Banner Versión 2 (Figma) -->
    <div class="modulo-hero-v2">
      <div class="modulo-hero-content">
        <div class="modulo-hero-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          Módulo de Especialidad
        </div>
        <h1 class="modulo-hero-title"><%= modulo.nombre %></h1>
        <p class="modulo-hero-desc"><%= modulo.descripcion %></p>
      </div>

      <div class="modulo-progress-gauge">
        <div class="modulo-gauge-pct"><%= pctModulo %>%</div>
        <div class="modulo-gauge-label">Progreso Módulo</div>
      </div>
    </div>

    <!-- Timeline de RAPs Versión 2 (Figma) -->
    <div class="path-container-v2">
      <% if (raps.length === 0) { %>
        <p class="text-muted">Este módulo aún no tiene RAPs asignados.</p>
      <% } else { %>
        <% 
          // Agrupar actividades por RAP
          const actPorRap = {};
          actividades.forEach(a => {
            if (!actPorRap[a.rap]) actPorRap[a.rap] = [];
            actPorRap[a.rap].push(a);
          });
        %>

        <% raps.forEach(r => { 
          const acts = actPorRap[r._id.toString()] || [];
        %>
          <div class="rap-node-v2">
            <div class="rap-title-v2">
              <span><%= r.nombre %></span>
            </div>
            
            <% if (acts.length === 0) { %>
              <div class="alert alert-warning" style="margin-left: 10px;">No hay actividades visibles en este RAP por el momento.</div>
            <% } else { %>
              <div>
                <% acts.forEach(act => { 
                  const entrega = entregaMap[act._id.toString()];
                  let statusClass = 'status-pendiente';
                  let statusText = 'Pendiente';
                  let statusIcon = '⏳';

                  if (entrega) {
                    if (entrega.estado === 'Entregado') { statusClass = 'status-entregado'; statusText = 'En revisión'; statusIcon = '👀'; }
                    else if (entrega.estado === 'Aprobado') { statusClass = 'status-aprobado'; statusText = 'Aprobado'; statusIcon = '✅'; }
                    else if (entrega.estado === 'Reprobado') { statusClass = 'status-reprobado'; statusText = 'Reprobado'; statusIcon = '❌'; }
                  }
                %>
                  <a href="/aprendiz/actividad/<%= act._id %>" class="act-card-v2">
                    <div class="act-info-v2">
                      <div class="act-icon-v2 <%= act.tipo %>">
                        <%= act.tipo === 'blog' ? '📖' : (act.tipo === 'juego' ? '🎮' : '📝') %>
                      </div>
                      <div>
                        <div class="act-meta-v2"><%= act.momentoPedagogico %></div>
                        <div class="act-title-v2"><%= act.titulo %></div>
                      </div>
                    </div>
                    <div class="status-badge-v2 <%= statusClass %>">
                      <span><%= statusIcon %></span> <%= statusText %>
                    </div>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>

