<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="layout">
  <!-- SIDEBAR -->
  <nav class="sidebar">
    <% locals.currentPath = '/aprendiz'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'aprendiz' } }) %>
  </nav>

  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Aprendiz' }) %>

  <main class="main">
    <div class="page-header mb-24">
      <div class="modulo-hero-tag" style="background: var(--verde-soft); color: var(--verde-text); margin-bottom: 8px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        Programa de Formación en Enfermería
      </div>
      <h1 class="page-title">Mi Ruta de Aprendizaje</h1>
      <p class="page-subtitle">Ficha asignada: <strong><%= ficha.nombre %></strong></p>
    </div>

    <% 
      const modulosCompletados = modulos.filter(m => m.pct === 100).length;
    %>

    <!-- Tarjetas KPI de Resumen (Versión 2 Figma) -->
    <div class="kpi-row">
      <div class="kpi-card">
        <div class="kpi-icon-wrap">
          <span>📊</span>
        </div>
        <div>
          <div class="kpi-number"><%= pctTotal %>%</div>
          <div class="kpi-desc">Progreso Total</div>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-icon-wrap" style="background: #e0f2fe; color: #0369a1;">
          <span>📚</span>
        </div>
        <div>
          <div class="kpi-number"><%= modulos.length %></div>
          <div class="kpi-desc">Módulos Asignados</div>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-icon-wrap" style="background: #fef3c7; color: #b45309;">
          <span>🎯</span>
        </div>
        <div>
          <div class="kpi-number"><%= modulosCompletados %> / <%= modulos.length %></div>
          <div class="kpi-desc">Módulos Completados</div>
        </div>
      </div>
    </div>

    <!-- Barra de Progreso Global -->
    <div class="card mb-24">
      <div class="progress-label">
        <span class="fw-600">Avance curricular de la ficha</span>
        <span class="fw-700" style="color: var(--verde-sena);"><%= pctTotal %>%</span>
      </div>
      <div class="progress-wrap">
        <div class="progress-bar" style="width:<%= pctTotal %>%"></div>
      </div>
    </div>

    <!-- Catálogo de Módulos (Versión 2 Figma) -->
    <div class="mb-16">
      <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--texto); margin-bottom: 14px;">Módulos del Curso</h2>
    </div>

    <% if (modulos.length === 0) { %>
      <div class="alert alert-warning">Aún no tienes módulos disponibles para ingresar. Completa los módulos anteriores para desbloquear los siguientes.</div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:16px;">
        <% modulos.forEach((m, i) => { 
          const padNum = (i + 1).toString().padStart(2, '0');
        %>
          <a href="/aprendiz/modulo/<%= m._id %>" class="modulo-card">
            <div class="modulo-card-header">
              <div class="flex gap-16" style="align-items:center;">
                <div class="modulo-num"><%= padNum %></div>
                <div>
                  <div class="fw-700" style="font-size: 1.1rem; color: var(--texto);"><%= m.nombre %></div>
                  <% if (m.descripcion) { %>
                    <div class="text-muted" style="margin-top: 3px;"><%= m.descripcion %></div>
                  <% } %>
                </div>
              </div>
              <div class="flex gap-12" style="align-items:center;">
                <% if (m.pct === 100) { %>
                  <span class="status-badge-v2 status-aprobado">✅ Completado</span>
                <% } else if (m.pct > 0) { %>
                  <span class="status-badge-v2 status-entregado">⏳ En curso</span>
                <% } else { %>
                  <span class="status-badge-v2 status-pendiente">⚪ Por iniciar</span>
                <% } %>
                
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--texto-muted);">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </div>
            </div>
            
            <div class="progress-label">
              <span>Avance del módulo</span>
              <span class="fw-700" style="color: var(--verde-sena);"><%= m.pct %>%</span>
            </div>
            <div class="progress-wrap">
              <div class="progress-bar" style="width:<%= m.pct %>%"></div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
</body>
</html>

