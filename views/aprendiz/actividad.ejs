<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= actividad.titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<%
  const previewMode = typeof locals.previewMode !== 'undefined' && locals.previewMode;
  const topbarRol = typeof locals.topbarRol !== 'undefined' ? locals.topbarRol : 'Aprendiz';
  const sidebarRol = typeof locals.sidebarRol !== 'undefined' ? locals.sidebarRol : 'aprendiz';
  const backHref = typeof locals.backHref !== 'undefined' ? locals.backHref : ('/aprendiz/modulo/' + actividad.modulo._id);
%>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: topbarRol }) %>
  <nav class="sidebar">
    <%- include('../partials/sidebar', { session: { userRol: sidebarRol } }) %>
  </nav>
  <main class="main">
    <div class="page-header flex-between">
      <div>
        <h1 class="page-title"><%= actividad.titulo %></h1>
        <p class="page-subtitle">
          <%= actividad.modulo.nombre %> › <%= actividad.rap.nombre %> ·
          <span class="badge badge-info"><%= actividad.momentoPedagogico %></span>
        </p>
      </div>
      <a href="<%= backHref %>" class="btn btn-ghost">← Volver</a>
    </div>

    <% if (previewMode) { %>
      <div class="alert alert-info">👁️ <strong>Vista previa</strong> — así verán esta actividad los aprendices. Ninguna respuesta o resultado se guarda aquí.</div>
    <% } %>

    <% if (error && error.length) { %><div class="alert alert-error"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>

    <!-- Estado actual -->
    <% if (entrega.estado !== 'Pendiente') { %>
    <div class="alert <%= entrega.estado === 'Aprobado' ? 'alert-success' : entrega.estado === 'Reprobado' ? 'alert-error' : 'alert-warning' %>">
      <strong>Estado:</strong> <%= entrega.estado %>
      <% if (entrega.porcentaje !== null) { %> · <strong><%= entrega.porcentaje %>%</strong><% } %>
      <% if (entrega.retroalimentacion) { %><br><em>Retroalimentación: <%= entrega.retroalimentacion %></em><% } %>
    </div>
    <% } %>

    <!-- ══ BLOG ══════════════════════════════════════════════ -->
    <% if (actividad.tipo === 'blog') { %>
    <div class="card" style="margin-bottom:20px;">
      <div class="rich-content">
        <%- actividad.contenidoRico %>
      </div>
      <% if (actividad.urlYoutube) { %>
        <div style="margin-top:20px;aspect-ratio:16/9;border-radius:10px;overflow:hidden;">
          <iframe src="<%= actividad.urlYoutube %>" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
        </div>
      <% } %>
    </div>

    <!-- Entrega -->
    <% if (actividad.tipoEntrega && (entrega.estado === 'Pendiente' || entrega.segundoIntentoHabilitado)) { %>
    <div class="card">
      <div class="card-title">Tu entrega</div>
      <% if (previewMode) { %>
        <p class="game-description" style="margin-bottom:0;">Aquí el aprendiz podrá enviar su <%= actividad.tipoEntrega === 'texto' ? 'respuesta en texto' : 'archivo' %>. (No disponible en la vista previa)</p>
      <% } else { %>
      <form action="/aprendiz/entregar" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="actividadId" value="<%= actividad._id %>">
        <% if (actividad.tipoEntrega === 'texto') { %>
          <div class="form-group">
            <label>Tu respuesta</label>
            <textarea name="respuestaTexto" rows="6" required><%= entrega.respuestaTexto || '' %></textarea>
          </div>
        <% } else { %>
          <div class="form-group">
            <label>Sube tu archivo</label>
            <input type="file" name="archivo">
          </div>
        <% } %>
        <button type="submit" class="btn btn-primary">Enviar entrega</button>
      </form>
      <% } %>
    </div>
    <% } %>

    <!-- ══ JUEGO ═════════════════════════════════════════════ -->
    <% } else if (actividad.tipo === 'juego') { %>
    <style>
      /* Estilos generales de los juegos */
      .game-card {
        padding: 24px;
        background: white;
        border-radius: var(--radio);
        border: 1px solid var(--gris-borde);
        box-shadow: var(--sombra);
      }
      .game-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--azul);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .game-description {
        font-size: 0.9rem;
        color: var(--texto-suave);
        margin-bottom: 20px;
      }
      .game-workspace {
        padding: 20px;
        background: var(--gris);
        border-radius: var(--radio);
        border: 1px solid var(--gris-borde);
        margin-bottom: 20px;
        position: relative;
      }

      /* Estilos: Juego de Emparejar (dos columnas unidas con una línea) */
      .linkmatch-wrap {
        position: relative;
        display: flex;
        justify-content: space-between;
        gap: 8vw;
        max-width: 620px;
        margin: 0 auto;
        padding: 4px 0;
      }
      @media (max-width: 560px) {
        .linkmatch-wrap { gap: 32px; }
      }
      .linkmatch-svg {
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 1;
      }
      .linkmatch-col {
        position: relative;
        z-index: 2;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .linkmatch-item {
        display: flex;
        align-items: center;
        gap: 10px;
        background: white;
        border: 1.5px solid var(--gris-borde);
        border-radius: 8px;
        padding: 10px 10px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--azul);
        transition: background 0.15s, border-color 0.15s;
      }
      .linkmatch-col-b .linkmatch-item {
        flex-direction: row-reverse;
        text-align: right;
        color: var(--verde-oscuro);
      }
      /* Todo el contenedor (no un punto aparte) es el asa de arrastre */
      .linkmatch-col-a .linkmatch-item {
        cursor: grab;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
      }
      .linkmatch-text { flex: 1; }
      .linkmatch-item.matched {
        color: #3a3a3a;
      }

      /* Contador de tiempo (todos los juegos) */
      .game-timer-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: white;
        border: 1.5px solid var(--gris-borde);
        border-radius: 8px;
        padding: 8px 16px;
        margin-bottom: 16px;
        font-weight: 700;
        color: var(--azul);
        font-size: 0.95rem;
      }
      .game-timer-bar.warning {
        color: #92400e;
        border-color: var(--amarillo);
        background: var(--amarillo-soft);
      }
      .game-timer-bar.danger {
        color: #e53935;
        border-color: #e53935;
        animation: flash-red 0.8s infinite alternate;
      }

      /* Estilos: Muñeco del ahorcado */
      .hangman-doll-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .hangman-figure {
        display: block;
      }
      .hangman-attempts {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--texto-suave);
      }

      /* Estilos: Juego Ahorcado Salud (Monitor EKG) */
      .ekg-panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
      }
      .ekg-monitor {
        width: 100%;
        max-width: 320px;
        height: 120px;
        background: #0d1117;
        border-radius: 8px;
        border: 3px solid #30363d;
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        font-family: monospace;
        color: #58a6ff;
        position: relative;
        overflow: hidden;
      }
      .ekg-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        border-bottom: 1px solid #30363d;
        padding-bottom: 4px;
      }
      .ekg-svg {
        flex: 1;
        width: 100%;
        height: 50px;
      }
      .ekg-line {
        stroke-dasharray: 600;
        animation: ekg-pulse 2.5s linear infinite;
      }
      @keyframes ekg-pulse {
        0% { stroke-dashoffset: 600; }
        100% { stroke-dashoffset: 0; }
      }
      .ekg-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: #39A900;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .ekg-value.panic {
        color: #e53935;
        animation: flash-red 0.5s infinite alternate;
      }
      @keyframes flash-red {
        from { opacity: 0.4; }
        to { opacity: 1; }
      }
      .hangman-word-slots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin: 24px 0;
        flex-wrap: wrap;
      }
      .word-slot {
        width: 32px;
        height: 38px;
        border-bottom: 3.5px solid var(--azul);
        font-size: 1.6rem;
        font-weight: 700;
        text-align: center;
        text-transform: uppercase;
        color: var(--azul);
      }
      .hangman-clue-box {
        background: var(--azul-claro);
        border-left: 4px solid var(--azul);
        padding: 12px 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 0.9rem;
      }
      .letters-keyboard {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        max-width: 550px;
        margin: 0 auto;
      }
      @media (max-width: 500px) {
        .letters-keyboard {
          grid-template-columns: repeat(5, 1fr);
        }
      }
      .letter-key {
        padding: 10px;
        border-radius: 6px;
        background: white;
        border: 1.5px solid var(--gris-borde);
        font-weight: bold;
        font-size: 1rem;
        cursor: pointer;
        text-align: center;
        transition: all 0.1s;
      }
      .letter-key:hover:not(:disabled) {
        background: var(--verde-claro);
        border-color: var(--verde);
        color: var(--verde-oscuro);
      }
      .letter-key:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      /* Estilos: Sopa de Letras */
      .wordsearch-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
      }
      .wordsearch-grid {
        display: grid;
        gap: 4px;
        width: 100%;
        max-width: 380px;
        background: var(--gris-borde);
        padding: 6px;
        border-radius: 8px;
      }
      .wordsearch-cell {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        font-weight: 700;
        font-family: var(--mono);
        cursor: pointer;
        border-radius: 4px;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
        border: none;
        font-size: 1.05rem;
        color: var(--texto);
        transition: all 0.15s;
      }
      .wordsearch-cell:hover:not(.found) {
        background: var(--azul-claro);
        color: var(--azul);
      }
      .wordsearch-cell.selected {
        background: var(--amarillo) !important;
        color: white !important;
      }
      .wordsearch-cell.wrong {
        background: #ef4444 !important;
        color: white !important;
        animation: wordsearch-shake 0.15s ease-in-out 2;
      }
      @keyframes wordsearch-shake {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
      }
      .wordsearch-cell.found {
        color: #3a3a3a;
        font-weight: 800;
      }
      .wordsearch-controls {
        display: flex;
        gap: 12px;
        width: 100%;
        max-width: 380px;
        justify-content: space-between;
        align-items: center;
      }
      .wordsearch-current {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--azul);
        background: white;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid var(--gris-borde);
      }
      .wordsearch-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        max-width: 500px;
        margin-top: 10px;
      }
      .word-badge {
        padding: 6px 12px;
        border-radius: 20px;
        background: white;
        border: 1px solid var(--gris-borde);
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--texto-suave);
      }
      .word-badge.found {
        background: var(--verde-claro);
        color: var(--verde-oscuro);
        border-color: var(--verde);
        text-decoration: line-through;
      }
    </style>

    <div class="game-card">
      <div class="game-title">
        <span>🎮</span>
        <span><%= actividad.tipoJuego.replace('juego_','').replace(/_/g,' ').toUpperCase() %></span>
      </div>
      <p class="game-description"><%= actividad.descripcion %></p>

      <% if (entrega.estado === 'Aprobado') { %>
        <div class="alert alert-success" style="margin-bottom: 0;">
          <strong>✅ ¡Excelente trabajo!</strong> Has aprobado esta actividad didáctica<% if (entrega.porcentaje !== null) { %> con el <%= entrega.porcentaje %>%<% } %>.
        </div>
      <% } else if (actividad.tipoJuego === 'juego_completar_oracion') { %>
        <div class="game-workspace">
          <% if (!actividad.juegoOracionItems || !actividad.juegoOracionItems.length) { %>
            <p class="game-description" style="margin-bottom:0;">Este juego aún no tiene oraciones configuradas. Vuelve más tarde.</p>
          <% } else { %>
            <div id="game-timer-bar" class="game-timer-bar" style="display:none;"></div>
            <form id="form-oracion" action="/aprendiz/juego-oracion/<%= actividad._id %>/entregar" method="POST" <% if (previewMode) { %>onsubmit="return handlePreviewFormSubmit(event)"<% } %>>
              <% actividad.juegoOracionItems.forEach((item, i) => { %>
                <% const partes = item.oracion.split('___'); %>
                <div style="margin-bottom:18px;padding:14px;background:white;border:1px solid var(--gris-borde);border-radius:8px;">
                  <p style="margin-bottom:0;line-height:2.2;">
                    <% if (partes.length > 1) { %>
                      <%= partes[0] %><input type="text" name="respuesta_<%= i %>" required style="width:160px;text-align:center;font-weight:600;border:none;border-bottom:2.5px solid var(--azul);background:transparent;"><%= partes.slice(1).join('___') %>
                    <% } else { %>
                      <%= item.oracion %>
                      <br>
                      <input type="text" name="respuesta_<%= i %>" required placeholder="Completa la oración" style="margin-top:8px;width:100%;">
                    <% } %>
                  </p>
                </div>
              <% }) %>
              <button type="submit" class="btn btn-primary">Enviar respuestas</button>
            </form>
          <% } %>
        </div>
      <% } else { %>
        <div class="game-workspace">
          <div id="game-timer-bar" class="game-timer-bar" style="display:none;"></div>
          <!-- Espacio dinámico para el juego actual -->
          <div id="game-active-area"></div>
        </div>
      <% } %>
    </div>

    <!-- Script de configuración de juegos -->
    <% if (entrega.estado !== 'Aprobado') { %>
    <script>
      const GAME_DATA = <%- gameDataJson %>;

      document.addEventListener('DOMContentLoaded', () => {
        const tipoJuego = '<%= actividad.tipoJuego %>';

        if (tipoJuego === 'juego_completar_oracion') {
          initSentenceGameTimer();
          return;
        }

        const activeArea = document.getElementById('game-active-area');
        if (!activeArea) return;

        if (tipoJuego === 'juego_emparejar') {
          initMatchingGame(activeArea, GAME_DATA.emparejar);
        } else if (tipoJuego === 'juego_emparejar_conceptos') {
          initMatchingGame(activeArea, GAME_DATA.conceptos);
        } else if (tipoJuego === 'juego_ahorcado_salud') {
          initHangmanGame(activeArea, GAME_DATA.ahorcado);
        } else if (tipoJuego === 'juego_sopa_letras') {
          initWordSearchGame(activeArea, GAME_DATA.sopa);
        }
      });

      function mostrarSinContenido(container) {
        container.innerHTML = '<p class="game-description" style="margin-bottom:0;">Este juego aún no tiene contenido configurado. Vuelve más tarde.</p>';
      }

      // ─── CONTADOR DE TIEMPO (todos los juegos) ─────────────────────────
      let __gameTimerInterval = null;

      function clearGameTimer() {
        if (__gameTimerInterval) {
          clearInterval(__gameTimerInterval);
          __gameTimerInterval = null;
        }
      }

      function startGameTimer(minutes, onTimeout) {
        clearGameTimer();
        const bar = document.getElementById('game-timer-bar');
        if (!bar || !minutes || minutes <= 0) return;

        let secondsLeft = Math.round(minutes * 60);
        bar.style.display = 'flex';
        renderTimer();

        __gameTimerInterval = setInterval(() => {
          secondsLeft--;
          if (secondsLeft <= 0) {
            clearGameTimer();
            bar.innerHTML = '<span>⏰ Tiempo agotado</span>';
            bar.classList.add('danger');
            onTimeout();
            return;
          }
          renderTimer();
        }, 1000);

        function renderTimer() {
          const m = Math.floor(secondsLeft / 60).toString().padStart(2, '0');
          const s = (secondsLeft % 60).toString().padStart(2, '0');
          bar.innerHTML = `<span>⏱️ Tiempo restante</span><span>${m}:${s}</span>`;
          bar.classList.toggle('warning', secondsLeft <= 60 && secondsLeft > 20);
          bar.classList.toggle('danger', secondsLeft <= 20);
        }
      }

      function initSentenceGameTimer() {
        const form = document.getElementById('form-oracion');
        if (!form) return;
        startGameTimer(GAME_DATA.tiempoLimiteMin, () => {
          alert('⏰ Se agotó el tiempo. Se enviarán tus respuestas tal como están.');
          form.submit();
        });
      }

      // ─── 1. JUEGO DE EMPAREJAR ─────────────────────────────────────────
      function initMatchingGame(container, pares) {
        if (!pares || !pares.length) return mostrarSinContenido(container);

        // Columna A conserva el orden original de las palabras/conceptos;
        // la columna B se mezcla aparte para que la posición no delate la respuesta.
        const colA = pares.map((p, idx) => ({ id: idx, text: p.termino }));
        const colB = pares.map((p, idx) => ({ id: idx, text: p.significado }));
        colB.sort(() => Math.random() - 0.5);

        container.innerHTML = `
          <div class="linkmatch-wrap" id="linkmatch-wrap">
            <svg class="linkmatch-svg" id="linkmatch-svg"></svg>
            <div class="linkmatch-col linkmatch-col-a" id="linkmatch-col-a">
              ${colA.map(item => `
                <div class="linkmatch-item" data-id="${item.id}" data-side="a">
                  <span class="linkmatch-text">${item.text}</span>
                </div>
              `).join('')}
            </div>
            <div class="linkmatch-col linkmatch-col-b" id="linkmatch-col-b">
              ${colB.map(item => `
                <div class="linkmatch-item" data-id="${item.id}" data-side="b">
                  <span class="linkmatch-text">${item.text}</span>
                </div>
              `).join('')}
            </div>
          </div>
          <p class="game-description" style="text-align:center;margin:14px 0 0;">Arrastra desde la palabra hasta el concepto para unirlos. Puedes volver a arrastrar para corregir una unión.</p>
        `;

        const wrapEl = document.getElementById('linkmatch-wrap');
        const svgEl = document.getElementById('linkmatch-svg');
        const aToB = new Map(); // aId -> bId
        const bToA = new Map(); // bId -> aId
        // Un color pastel distinto por pareja, repartidos por el círculo de
        // matices para que dos parejas consecutivas nunca queden en el mismo
        // tono (ej. rosa y luego un rosa más claro).
        const pastelColors = generateDistinctPastelColors(pares.length);
        let finished = false;
        let dragging = null; // { id, x, y } coordenadas de origen del arrastre
        let ghostLine = null;

        startGameTimer(GAME_DATA.tiempoLimiteMin, () => {
          if (finished) return;
          finished = true;
          const pct = Math.round((countCorrectas() / pares.length) * 100);
          alert('⏰ Se agotó el tiempo. Se calificará según las parejas correctas que uniste.');
          completarJuego(pct);
        });

        function countCorrectas() {
          let n = 0;
          aToB.forEach((bId, aId) => { if (bId === aId) n++; });
          return n;
        }

        function generateDistinctPastelColors(n) {
          const startHue = Math.floor(Math.random() * 360);
          const step = 360 / n;
          const colors = [];
          for (let i = 0; i < n; i++) {
            const hue = Math.round((startHue + step * i) % 360);
            const lightness = 86 + (i % 3) * 2; // ligera variación 86/88/90%
            colors.push({ bg: `hsl(${hue}, 70%, ${lightness}%)`, stroke: `hsl(${hue}, 55%, 48%)` });
          }
          return colors;
        }

        function sizeSvg() {
          svgEl.setAttribute('width', wrapEl.clientWidth);
          svgEl.setAttribute('height', wrapEl.clientHeight);
        }

        // El punto de anclaje de la línea es el borde del contenedor (no un
        // círculo aparte), para que visualmente "salga" de la palabra/concepto.
        function anchorPoint(id, side) {
          const item = wrapEl.querySelector(`.linkmatch-item[data-side="${side}"][data-id="${id}"]`);
          if (!item) return null;
          const rect = item.getBoundingClientRect();
          const wrapRect = wrapEl.getBoundingClientRect();
          return {
            x: (side === 'a' ? rect.right : rect.left) - wrapRect.left,
            y: rect.top + rect.height / 2 - wrapRect.top,
          };
        }

        function drawLine(x1, y1, x2, y2, cls) {
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', x1);
          line.setAttribute('y1', y1);
          line.setAttribute('x2', x2);
          line.setAttribute('y2', y2);
          line.setAttribute('stroke-linecap', 'round');
          line.setAttribute('class', cls);
          svgEl.appendChild(line);
          return line;
        }

        function renderPermanentLines() {
          sizeSvg();
          svgEl.querySelectorAll('.linkmatch-line-ok').forEach(l => l.remove());
          aToB.forEach((bId, aId) => {
            const a = anchorPoint(aId, 'a');
            const b = anchorPoint(bId, 'b');
            if (!a || !b) return;
            const line = drawLine(a.x, a.y, b.x, b.y, 'linkmatch-line-ok');
            const colors = pastelColors[aId];
            line.setAttribute('stroke', colors ? colors.stroke : '#999');
            line.setAttribute('stroke-width', '4');
          });
        }

        function updateGhostLine(toX, toY) {
          if (!dragging) return;
          if (!ghostLine) {
            ghostLine = drawLine(dragging.x, dragging.y, toX, toY, 'linkmatch-line-drag');
            ghostLine.setAttribute('stroke', 'var(--azul, #0369a1)');
            ghostLine.setAttribute('stroke-width', '3');
            ghostLine.setAttribute('stroke-dasharray', '6 4');
          } else {
            ghostLine.setAttribute('x2', toX);
            ghostLine.setAttribute('y2', toY);
          }
        }

        function clearGhostLine() {
          if (ghostLine) { ghostLine.remove(); ghostLine = null; }
        }

        function styleItem(side, id, colors) {
          const el = wrapEl.querySelector(`.linkmatch-item[data-side="${side}"][data-id="${id}"]`);
          if (!el) return;
          if (colors) {
            el.classList.add('matched');
            el.style.background = colors.bg;
            el.style.borderColor = 'transparent';
          } else {
            el.classList.remove('matched');
            el.style.background = '';
            el.style.borderColor = '';
          }
        }

        // Quita la unión que tenga actualmente el elemento "a" o "b" indicado,
        // para permitir rehacer una unión arrastrando de nuevo.
        function disconnect(aId, bId) {
          aToB.delete(aId);
          bToA.delete(bId);
          styleItem('a', aId, null);
          styleItem('b', bId, null);
        }

        function connect(aId, bId) {
          if (aToB.has(aId)) disconnect(aId, aToB.get(aId));
          if (bToA.has(bId)) disconnect(bToA.get(bId), bId);

          const colors = pastelColors[aId];
          aToB.set(aId, bId);
          bToA.set(bId, aId);
          styleItem('a', aId, colors);
          styleItem('b', bId, colors);
          renderPermanentLines();

          if (aToB.size === pares.length) {
            finished = true;
            clearGameTimer();
            const correctas = countCorrectas();
            const pct = Math.round((correctas / pares.length) * 100);
            setTimeout(() => {
              alert(`✅ Uniste todas las parejas. Acertaste ${correctas} de ${pares.length}.`);
              completarJuego(pct);
            }, 400);
          }
        }

        sizeSvg();

        wrapEl.querySelectorAll('.linkmatch-item[data-side="a"]').forEach(item => {
          item.addEventListener('pointerdown', (e) => {
            if (finished) return;
            e.preventDefault();
            const id = Number(item.dataset.id);
            const anchor = anchorPoint(id, 'a');
            dragging = { id, x: anchor.x, y: anchor.y };
            updateGhostLine(anchor.x, anchor.y);
          });
        });

        window.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const wrapRect = wrapEl.getBoundingClientRect();
          updateGhostLine(e.clientX - wrapRect.left, e.clientY - wrapRect.top);
        });

        window.addEventListener('pointerup', (e) => {
          if (!dragging) return;
          const startId = dragging.id;
          dragging = null;
          clearGhostLine();

          const target = document.elementFromPoint(e.clientX, e.clientY);
          const bItem = target ? target.closest('.linkmatch-item[data-side="b"]') : null;
          if (!bItem) return;

          // No importa si la pareja es correcta o incorrecta: siempre se une.
          connect(startId, Number(bItem.dataset.id));
        });

        window.addEventListener('resize', renderPermanentLines);
      }

      // ─── 2. JUEGO DEL AHORCADO SALUD (EKG MONITOR) ─────────────────────
      function initHangmanGame(container, palabras) {
        if (!palabras || !palabras.length) return mostrarSinContenido(container);

        // Seleccionar palabra aleatoria
        const gameItem = palabras[Math.floor(Math.random() * palabras.length)];
        const targetWord = (gameItem.palabra || '').toUpperCase().replace(/[^A-Z]/g, '');
        const clue = gameItem.pista || '(Sin pista)';

        if (!targetWord) return mostrarSinContenido(container);

        let guessedLetters = new Set();
        let wrongAttempts = 0;
        const maxAttempts = 6;
        let finished = false;

        // Render inicial
        updateHangmanUI();

        startGameTimer(GAME_DATA.tiempoLimiteMin, () => {
          if (finished) return;
          finished = true;
          const uniqueLetters = new Set(targetWord.split(''));
          const correctas = [...uniqueLetters].filter(ch => guessedLetters.has(ch)).length;
          const pct = Math.round((correctas / uniqueLetters.size) * 100);
          alert('⏰ Se agotó el tiempo. Se calificará según las letras que descubriste.');
          completarJuego(pct);
        });

        function hangmanFigureSvg() {
          const parts = [
            `<circle cx="80" cy="38" r="13" fill="none" stroke="#1f2937" stroke-width="3"/>`, // cabeza
            `<line x1="80" y1="51" x2="80" y2="85" stroke="#1f2937" stroke-width="3"/>`, // cuerpo
            `<line x1="80" y1="60" x2="65" y2="75" stroke="#1f2937" stroke-width="3"/>`, // brazo izq
            `<line x1="80" y1="60" x2="95" y2="75" stroke="#1f2937" stroke-width="3"/>`, // brazo der
            `<line x1="80" y1="85" x2="68" y2="110" stroke="#1f2937" stroke-width="3"/>`, // pierna izq
            `<line x1="80" y1="85" x2="92" y2="110" stroke="#1f2937" stroke-width="3"/>`, // pierna der
          ];
          let partsHtml = '';
          for (let i = 0; i < wrongAttempts && i < parts.length; i++) {
            partsHtml += parts[i];
          }
          return `
            <svg class="hangman-figure" viewBox="0 0 120 130" width="130" height="140">
              <line x1="10" y1="120" x2="90" y2="120" stroke="#6b7280" stroke-width="4" stroke-linecap="round"/>
              <line x1="30" y1="120" x2="30" y2="10" stroke="#6b7280" stroke-width="4" stroke-linecap="round"/>
              <line x1="30" y1="10" x2="80" y2="10" stroke="#6b7280" stroke-width="4" stroke-linecap="round"/>
              <line x1="80" y1="10" x2="80" y2="25" stroke="#6b7280" stroke-width="3"/>
              ${partsHtml}
            </svg>
          `;
        }

        function updateHangmanUI() {
          let wordSlotsHtml = '';
          let won = true;

          for (let char of targetWord) {
            if (guessedLetters.has(char)) {
              wordSlotsHtml += `<div class="word-slot">${char}</div>`;
            } else {
              wordSlotsHtml += `<div class="word-slot">&nbsp;</div>`;
              won = false;
            }
          }

          // EKG heart monitor values
          const hpPercent = Math.max(0, 100 - Math.round((wrongAttempts / maxAttempts) * 100));
          const bpm = hpPercent > 0 ? Math.round(50 + (hpPercent * 0.7)) : 0;
          const isPanic = hpPercent <= 35 && hpPercent > 0;
          
          let ekgPathD = "M0,50 L50,50 L60,30 L70,70 L85,50 L120,50 L130,10 L140,90 L155,50 L180,50 L190,30 L200,70 L215,50 L300,50";
          let ekgStroke = "#39A900";
          let animSpeed = "2.5s";

          if (hpPercent === 0) {
            ekgPathD = "M0,50 L300,50"; // Flatline
            ekgStroke = "#e53935";
            animSpeed = "0s";
          } else if (hpPercent <= 35) {
            ekgStroke = "#e53935";
            animSpeed = "0.8s"; // Fast cardiac pulse
          } else if (hpPercent <= 65) {
            ekgStroke = "#f59e0b";
            animSpeed = "1.5s";
          }

          let keyboardHtml = '';
          const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
          for (let char of letters) {
            const disabled = guessedLetters.has(char) || wrongAttempts >= maxAttempts || won ? 'disabled' : '';
            keyboardHtml += `<button class="letter-key" ${disabled} onclick="guessHangmanLetter('${char}', this)">${char}</button>`;
          }

          let gameContentHtml = `
            <div class="ekg-panel">
              <div class="hangman-doll-wrap">
                ${hangmanFigureSvg()}
                <div class="hangman-attempts">Intentos fallidos: ${wrongAttempts} / ${maxAttempts}</div>
              </div>
              <div class="ekg-monitor">
                <div class="ekg-header">
                  <span>VITAL SIGN MONITOR</span>
                  <span>HP: ${hpPercent}%</span>
                </div>
                <svg class="ekg-svg" viewBox="0 0 300 100">
                  <path class="ekg-line" d="${ekgPathD}" fill="none" stroke="${ekgStroke}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="animation: ekg-pulse ${animSpeed} linear infinite;"></path>
                </svg>
                <div class="ekg-value ${isPanic ? 'panic' : ''}">
                  <span>❤️ HEART RATE:</span>
                  <span>${bpm} BPM</span>
                  <span>${hpPercent === 0 ? '[FLATLINE]' : hpPercent <= 35 ? '[CRITICAL]' : '[STABLE]'}</span>
                </div>
              </div>
            </div>

            <div class="hangman-clue-box">
              <strong>Clue:</strong> ${clue}
            </div>

            <div class="hangman-word-slots">
              ${wordSlotsHtml}
            </div>

            <div class="letters-keyboard">
              ${keyboardHtml}
            </div>
          `;

          if (won) {
            finished = true;
            clearGameTimer();
            gameContentHtml += `
              <div class="alert alert-success" style="margin-top: 20px; text-align: center;">
                <strong>🎉 ¡Buen trabajo!</strong> Descubriste la palabra: <strong>${targetWord}</strong>
              </div>
            `;
            setTimeout(() => { completarJuego(); }, 1500);
          } else if (wrongAttempts >= maxAttempts) {
            finished = true;
            clearGameTimer();
            gameContentHtml += `
              <div class="alert alert-error" style="margin-top: 20px; text-align: center; display: block;">
                <strong>💀 Paciente inestable.</strong> La palabra era: <strong>${targetWord}</strong>
                <br>
                <button class="btn btn-secondary btn-sm" style="margin-top: 10px;" onclick="initHangmanGame(document.getElementById('game-active-area'), GAME_DATA.ahorcado)">Reintentar</button>
              </div>
            `;
          }

          container.innerHTML = gameContentHtml;
        }

        window.guessHangmanLetter = function(char, btnEl) {
          if (finished) return;
          guessedLetters.add(char);
          btnEl.disabled = true;

          if (!targetWord.includes(char)) {
            wrongAttempts++;
          }
          updateHangmanUI();
        }
      }

      // ─── 3. JUEGO DE SOPA DE LETRAS ────────────────────────────────────
      function initWordSearchGame(container, palabras) {
        if (!palabras || !palabras.length) return mostrarSinContenido(container);

        const translations = {};
        let targetWords = palabras
          .map(p => {
            const w = (p.palabra || '').toUpperCase().replace(/[^A-Z]/g, '');
            if (w) translations[w] = p.traduccion || '';
            return w;
          })
          .filter(w => w.length > 0);

        const longest = Math.max(...targetWords.map(w => w.length), 0);
        const size = Math.min(16, Math.max(10, longest + 2));
        targetWords = targetWords.filter(w => w.length <= size);

        if (!targetWords.length) return mostrarSinContenido(container);

        let grid = Array(size).fill(null).map(() => Array(size).fill(''));
        let foundWords = new Set();
        let selectedCells = []; // array de objetos {r, c, letter}
        let flashingCell = null; // {r, c} celda incorrecta parpadeando en rojo
        let inputLocked = false;
        let finished = false;
        let isDragging = false; // arrastrar de letra a letra con el mouse/dedo
        window.wsFoundCells = []; // {r, c, color} celdas ya encontradas (color pastel)

        function randomPastelColor() {
          const hue = Math.floor(Math.random() * 360);
          return `hsl(${hue}, 70%, 85%)`;
        }

        // Generar grilla
        generateGrid();

        // Termina el arrastre al soltar el mouse/dedo, ocurra donde ocurra
        window.addEventListener('pointerup', () => { isDragging = false; });
        window.addEventListener('pointercancel', () => { isDragging = false; });

        startGameTimer(GAME_DATA.tiempoLimiteMin, () => {
          if (finished) return;
          finished = true;
          inputLocked = true;
          const pct = Math.round((foundWords.size / targetWords.length) * 100);
          alert('⏰ Se agotó el tiempo. Se calificará según las palabras que encontraste.');
          completarJuego(pct);
        });

        function generateGrid() {
          // Direcciones posibles: horizontal, vertical y ambas diagonales.
          // (La lectura al revés ya la soporta la validación de la palabra,
          // así que no hace falta duplicar direcciones "hacia atrás".)
          const direcciones = [
            { dr: 0, dc: 1 },  // horizontal →
            { dr: 1, dc: 0 },  // vertical ↓
            { dr: 1, dc: 1 },  // diagonal ↘
            { dr: 1, dc: -1 }, // diagonal ↙
          ];

          // Intentar posicionar cada palabra
          targetWords.forEach(word => {
            let placed = false;
            let attempts = 0;
            while (!placed && attempts < 200) {
              attempts++;
              const { dr, dc } = direcciones[Math.floor(Math.random() * direcciones.length)];
              const row = Math.floor(Math.random() * size);
              const col = Math.floor(Math.random() * size);

              const endRow = row + dr * (word.length - 1);
              const endCol = col + dc * (word.length - 1);
              if (endRow < 0 || endRow >= size || endCol < 0 || endCol >= size) continue;

              let fits = true;
              for (let i = 0; i < word.length; i++) {
                const rr = row + dr * i;
                const cc = col + dc * i;
                if (grid[rr][cc] !== '' && grid[rr][cc] !== word[i]) {
                  fits = false;
                  break;
                }
              }
              if (fits) {
                for (let i = 0; i < word.length; i++) {
                  const rr = row + dr * i;
                  const cc = col + dc * i;
                  grid[rr][cc] = word[i];
                }
                placed = true;
              }
            }
          });

          // Rellenar resto
          const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
          for (let r = 0; r < size; r++) {
            for (let c = 0; c < size; c++) {
              if (grid[r][c] === '') {
                grid[r][c] = alphabet.charAt(Math.floor(Math.random() * alphabet.length));
              }
            }
          }
        }

        // El DOM de la grilla se construye UNA sola vez; los cambios de
        // selección solo actualizan clases/estilos de las celdas existentes.
        // (Recrear los botones a mitad de un arrastre cancela el gesto de
        // puntero/touch en varios navegadores porque el elemento "tocado"
        // desaparece del DOM — eso era lo que rompía el arrastre.)
        let cellEls = Array(size).fill(null).map(() => Array(size).fill(null));

        buildWordSearchUI();
        updateWordSearchUI();

        function buildWordSearchUI() {
          let gridHtml = `<div class="wordsearch-grid" style="grid-template-columns: repeat(${size}, 1fr);">`;
          for (let r = 0; r < size; r++) {
            for (let c = 0; c < size; c++) {
              gridHtml += `<button type="button" class="wordsearch-cell" data-row="${r}" data-col="${c}">${grid[r][c]}</button>`;
            }
          }
          gridHtml += '</div>';

          container.innerHTML = `
            <div class="wordsearch-container">
              ${gridHtml}

              <div class="wordsearch-controls">
                <div class="wordsearch-current" id="ws-current">
                  Palabra: <strong>...</strong>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" id="ws-clear-btn">Limpiar selección</button>
              </div>

              <div class="wordsearch-list" id="ws-word-list"></div>
            </div>
          `;

          container.querySelectorAll('.wordsearch-cell').forEach(el => {
            const r = Number(el.dataset.row);
            const c = Number(el.dataset.col);
            cellEls[r][c] = el;
            // Permite tanto el clic letra por letra como arrastrar el puntero
            // (mouse o dedo) de una letra a otra para ir seleccionando el camino.
            el.addEventListener('pointerdown', (e) => {
              e.preventDefault();
              isDragging = true;
              selectWordSearchCell(r, c);
            });
            el.addEventListener('pointerenter', () => {
              if (isDragging) selectWordSearchCell(r, c);
            });
          });

          const clearBtn = document.getElementById('ws-clear-btn');
          clearBtn.addEventListener('click', () => {
            if (inputLocked) return;
            selectedCells = [];
            updateWordSearchUI();
          });
        }

        // Actualiza solo clases/estilos de las celdas ya creadas, sin tocar el DOM.
        function updateWordSearchUI() {
          for (let r = 0; r < size; r++) {
            for (let c = 0; c < size; c++) {
              const el = cellEls[r][c];
              const isSelected = selectedCells.some(cell => cell.r === r && cell.c === c);
              const isWrong = !!(flashingCell && flashingCell.r === r && flashingCell.c === c);
              const foundColor = getFoundColor(r, c);
              el.classList.toggle('wrong', isWrong);
              el.classList.toggle('selected', !isWrong && isSelected);
              el.classList.toggle('found', !!foundColor);
              el.style.backgroundColor = (!isWrong && !isSelected && foundColor) ? foundColor : '';
            }
          }

          const currentEl = document.getElementById('ws-current');
          if (currentEl) {
            const currentWordSpelled = selectedCells.map(cell => cell.letter).join('');
            currentEl.innerHTML = `Palabra: <strong>${currentWordSpelled || '...'}</strong>`;
          }

          const listEl = document.getElementById('ws-word-list');
          if (listEl) {
            listEl.innerHTML = targetWords.map(word => {
              const found = foundWords.has(word);
              const traduccion = translations[word] ? ` (${translations[word]})` : '';
              return `<div class="word-badge ${found ? 'found' : ''}">${word}${traduccion}</div>`;
            }).join('');
          }
        }

        function getFoundColor(r, c) {
          const cell = window.wsFoundCells.find(cell => cell.r === r && cell.c === c);
          return cell ? cell.color : null;
        }

        function selectWordSearchCell(r, c) {
          if (finished || inputLocked) return;

          // Nota: una celda puede pertenecer a la vez a una palabra ya
          // encontrada Y a otra pendiente cuando dos palabras se cruzan, así
          // que "encontrada" no debe bloquear que se pueda volver a elegir.
          const index = selectedCells.findIndex(cell => cell.r === r && cell.c === c);
          if (index > -1) {
            // Deseleccionar esta celda y las que se agregaron después de ella
            selectedCells = selectedCells.slice(0, index);
            updateWordSearchUI();
            return;
          }

          // Intentar agregar la celda a la selección actual
          const tentativa = selectedCells.concat([{ r, c, letter: grid[r][c] }]);
          const spelled = tentativa.map(cell => cell.letter).join('');
          const pendientes = targetWords.filter(w => !foundWords.has(w));

          const esPrefijoValido = pendientes.some(w => w.startsWith(spelled)) ||
            pendientes.some(w => w.split('').reverse().join('').startsWith(spelled));

          if (!esPrefijoValido) {
            // Letra equivocada: se remarca en rojo unos milisegundos y se descarta
            inputLocked = true;
            flashingCell = { r, c };
            updateWordSearchUI();
            setTimeout(() => {
              flashingCell = null;
              inputLocked = false;
              updateWordSearchUI();
            }, 450);
            return;
          }

          // La letra pertenece a una palabra pendiente: se marca en amarillo/naranja
          selectedCells = tentativa;

          const palabraCompletada = pendientes.find(w =>
            w === spelled || w.split('').reverse().join('') === spelled);

          if (palabraCompletada) {
            foundWords.add(palabraCompletada);
            // Cada palabra encontrada obtiene un color pastel aleatorio propio.
            // Si una celda ya pertenecía a otra palabra encontrada (se cruzan),
            // conserva el color con el que se pintó primero.
            const color = randomPastelColor();
            selectedCells.forEach(cell => {
              const yaPintada = window.wsFoundCells.some(fc => fc.r === cell.r && fc.c === cell.c);
              if (!yaPintada) {
                window.wsFoundCells.push({ r: cell.r, c: cell.c, color });
              }
            });
            selectedCells = [];
            updateWordSearchUI();

            if (foundWords.size === targetWords.length) {
              finished = true;
              clearGameTimer();
              setTimeout(() => {
                alert('🎉 ¡Felicidades! Encontraste todas las palabras en la sopa de letras.');
                completarJuego();
              }, 500);
            }
            return;
          }

          updateWordSearchUI();
        }
      }

    </script>
    <% } %>

    <!-- ══ EVALUACIÓN ════════════════════════════════════════ -->
    <% } else if (actividad.tipo === 'evaluacion') { %>
    <div class="card" style="border-radius: 18px; padding: 28px;">
      <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;border-bottom:1.5px solid var(--gris-borde);padding-bottom:14px;margin-bottom:24px;">
        <span style="font-size: 1.15rem; font-weight: 700; color: var(--texto);">📝 Cuestionario Clínico</span>
        <span class="status-badge-v2 status-entregado"><%= actividad.preguntas.length %> Preguntas</span>
      </div>

      <% if (entrega.estado === 'Aprobado') { %>
        <div class="alert alert-success" style="border-radius: 12px; font-size: 1rem; padding: 18px;">
          <strong>✅ ¡Evaluación aprobada con éxito!</strong> Calificación obtenida: <strong><%= entrega.porcentaje %>%</strong>
        </div>
      <% } else { %>
      <form action="/aprendiz/evaluacion/<%= actividad._id %>/entregar" method="POST" <% if (previewMode) { %>onsubmit="return handlePreviewFormSubmit(event)"<% } %>>
        <% actividad.preguntas.forEach((p, i) => { %>
          <div class="quiz-question-card">
            <div class="quiz-question-header">
              <span class="modulo-num" style="width: 28px; height: 28px; font-size: 0.85rem; border-radius: 8px;"><%= i + 1 %></span>
              <span style="font-size: 1.05rem; font-weight: 600;"><%= p.enunciado %></span>
            </div>
            
            <div style="display:flex;flex-direction:column;gap:4px;margin-top:12px;">
              <% p.opciones.forEach((op, j) => { %>
                <label class="quiz-option-item">
                  <input type="radio" name="pregunta_<%= i %>" value="<%= j %>" required>
                  <span><%= op %></span>
                </label>
              <% }) %>
            </div>
          </div>
        <% }) %>
        <div style="margin-top: 24px; display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary btn-lg" style="padding: 12px 28px; font-weight: 600; border-radius: 10px;">
            <%= previewMode ? 'Vista previa: enviar (no se guarda)' : 'Enviar evaluación' %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </form>
      <% } %>
    </div>
    <% } %>
  </main>
</div>
<script>
const PREVIEW_MODE = <%= previewMode ? 'true' : 'false' %>;

function handlePreviewFormSubmit(e) {
  e.preventDefault();
  alert('👁️ Vista previa: así se enviaría esta actividad. No se guardó ningún resultado.');
  return false;
}

async function completarJuego(porcentaje) {
  if (PREVIEW_MODE) {
    alert('👁️ Vista previa: en este punto el aprendiz completaría la actividad. No se guardó ningún resultado.');
    return;
  }
  const res = await fetch('/aprendiz/juego/completar', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ actividadId: '<%= actividad._id %>', porcentaje })
  });
  const data = await res.json();
  if (data.ok) { alert(data.mensaje); location.reload(); }
}
</script>
</body>
</html>
