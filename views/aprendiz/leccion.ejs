<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .leccion-header {
      background: linear-gradient(135deg, #064e3b 0%, #0d5c3a 50%, #059669 100%);
      color: white;
      padding: 30px 36px;
      border-radius: 20px;
      margin-bottom: 26px;
      box-shadow: 0 12px 32px rgba(13, 92, 58, 0.2);
    }
    .leccion-header h1 { font-size: 1.8rem; margin-bottom: 8px; font-weight: 700; letter-spacing: -0.02em; }
    .leccion-header p { opacity: 0.9; font-size: 0.95rem; }

    .bloque { background: white; border: 1.5px solid var(--gris-borde); border-radius: 14px; padding: 22px; margin-bottom: 18px; box-shadow: var(--sombra-sm); }
    .bloque-nota { background: var(--verde-soft); border-left: 4px solid var(--verde-sena); color: var(--texto); }
    .bloque-separador { border: none; border-top: 2px dashed var(--gris-borde); background: transparent; padding: 0; margin: 24px 0; }

    .rich-content img, .rich-content video { max-width: 100%; border-radius: 10px; }
    .media-frame { aspect-ratio: 16/9; border-radius: 12px; overflow: hidden; border: 1px solid var(--gris-borde); }
    .media-frame iframe { width: 100%; height: 100%; border: 0; }

    .tarjetas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
    .tarjeta { perspective: 900px; height: 110px; cursor: pointer; }
    .tarjeta-inner { position: relative; width: 100%; height: 100%; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1); transform-style: preserve-3d; }
    .tarjeta.flipped .tarjeta-inner { transform: rotateY(180deg); }
    .tarjeta-front, .tarjeta-back {
      position: absolute; inset: 0; backface-visibility: hidden; border-radius: 12px;
      display: flex; align-items: center; justify-content: center; text-align: center; padding: 12px; font-weight: 600;
      box-shadow: var(--sombra-sm);
    }
    .tarjeta-front { background: var(--texto); color: white; border: 1px solid var(--texto); }
    .tarjeta-back { background: var(--verde-soft); color: var(--verde-text); border: 2px solid var(--verde-sena); transform: rotateY(180deg); }

    .faq-item { border-bottom: 1px solid var(--gris-borde); padding: 14px 0; }
    .faq-pregunta { font-weight: 600; color: var(--texto); cursor: pointer; display: flex; align-items: center; gap: 8px; }
    .faq-respuesta { color: var(--texto-suave); margin-top: 8px; padding-left: 18px; display: none; }
    .faq-item.abierta .faq-respuesta { display: block; }

    table.bloque-tabla { width: 100%; border-collapse: collapse; border-radius: 10px; overflow: hidden; }
    table.bloque-tabla th, table.bloque-tabla td { border: 1px solid var(--gris-borde); padding: 10px 14px; text-align: left; font-size: 0.9rem; }
    table.bloque-tabla th { background: #f8fafc; font-weight: 700; color: var(--texto); }

    .section-title { font-weight: 700; font-size: 1.15rem; color: var(--texto); margin: 28px 0 14px; display: flex; align-items: center; gap: 8px; }
  </style>
</head>
<body>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Aprendiz' }) %>

  <nav class="sidebar">
    <%- include('../partials/sidebar', { session: { userRol: 'aprendiz' } }) %>
  </nav>

  <main class="main">
    <a href="/aprendiz/modulo/<%= leccion.modulo._id %>" class="btn btn-ghost mb-16">← Volver al módulo</a>

    <div class="leccion-header">
      <h1 style="display: flex; align-items: center; gap: 10px;">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--verde-sena); flex-shrink: 0;"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <%= leccion.titulo %>
      </h1>
      <p><%= leccion.rap.nombre %> · <%= leccion.momentoPedagogico %></p>
      <% if (leccion.descripcion) { %><p style="margin-top:6px;"><%= leccion.descripcion %></p><% } %>
    </div>

    <!-- ══════════ CONTENIDO ══════════ -->
    <% if (bloques.length === 0) { %>
      <div class="alert alert-warning">Esta lección aún no tiene contenido. Revisa directamente las actividades más abajo.</div>
    <% } else { %>
      <% bloques.forEach(b => { %>
        <% const c = b.contenido || {}; %>

        <% if (b.tipo === 'texto') { %>
          <div class="bloque rich-content"><%- c.html %></div>

        <% } else if (b.tipo === 'video') { %>
          <div class="bloque">
            <div class="media-frame"><iframe src="<%= c.url %>" allowfullscreen></iframe></div>
          </div>

        <% } else if (b.tipo === 'imagen') { %>
          <div class="bloque" style="text-align:center;">
            <img src="<%= c.url %>" alt="<%= c.alt || '' %>" style="max-width:100%;border-radius:10px;">
            <% if (c.alt) { %><p class="text-muted mt-12"><%= c.alt %></p><% } %>
          </div>

        <% } else if (b.tipo === 'audio') { %>
          <div class="bloque">
            <audio controls src="<%= c.url %>" style="width:100%;"></audio>
          </div>

        <% } else if (b.tipo === 'pdf') { %>
          <div class="bloque">
            <a href="<%= c.url %>" target="_blank" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 6px;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <%= c.nombre || 'Ver PDF' %>
            </a>
          </div>

        <% } else if (b.tipo === 'tarjetas') { %>
          <div class="bloque">
            <div class="card-title" style="display: flex; align-items: center; gap: 8px;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              Tarjetas de estudio
            </div>
            <div class="tarjetas-grid">
              <% (c.pares || []).forEach(p => { %>
                <div class="tarjeta" onclick="this.classList.toggle('flipped')">
                  <div class="tarjeta-inner">
                    <div class="tarjeta-front"><%= p.frente %></div>
                    <div class="tarjeta-back"><%= p.reverso %></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

        <% } else if (b.tipo === 'faq') { %>
          <div class="bloque">
            <div class="card-title" style="display: flex; align-items: center; gap: 8px;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Preguntas frecuentes
            </div>
            <% (c.items || []).forEach(it => { %>
              <div class="faq-item" onclick="this.classList.toggle('abierta')">
                <div class="faq-pregunta">▸ <%= it.pregunta %></div>
                <div class="faq-respuesta"><%= it.respuesta %></div>
              </div>
            <% }) %>
          </div>

        <% } else if (b.tipo === 'nota') { %>
          <div class="bloque bloque-nota" style="display: flex; align-items: flex-start; gap: 8px;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            <div><%= c.texto %></div>
          </div>

        <% } else if (b.tipo === 'descargable') { %>
          <div class="bloque">
            <a href="<%= c.url %>" target="_blank" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 6px;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <%= c.nombre || 'Descargar archivo' %>
            </a>
          </div>

        <% } else if (b.tipo === 'enlace') { %>
          <div class="bloque">
            <a href="<%= c.url %>" target="_blank" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 6px;">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <%= c.titulo || c.url %>
            </a>
          </div>

        <% } else if (b.tipo === 'tabla') { %>
          <div class="bloque">
            <table class="bloque-tabla">
              <% if ((c.encabezados || []).length) { %>
                <thead><tr><% c.encabezados.forEach(h => { %><th><%= h %></th><% }) %></tr></thead>
              <% } %>
              <tbody>
                <% (c.filas || []).forEach(fila => { %>
                  <tr><% fila.forEach(celda => { %><td><%= celda %></td><% }) %></tr>
                <% }) %>
              </tbody>
            </table>
          </div>

        <% } else if (b.tipo === 'separador') { %>
          <hr class="bloque-separador">
        <% } %>
      <% }) %>
    <% } %>

    <!-- ══════════ ACTIVIDADES ══════════ -->
    <% if (actividades.length > 0) { %>
      <div class="section-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--verde-sena);">
          <circle cx="12" cy="12" r="10"/>
          <circle cx="12" cy="12" r="6"/>
          <circle cx="12" cy="12" r="2"/>
        </svg>
        Actividades Prácticas
      </div>
      <% actividades.forEach(act => {
        const entrega = entregaMap[act._id.toString()];
        let statusClass = 'status-pendiente';
        let statusText = 'Pendiente';

        if (entrega) {
          if (entrega.estado === 'Entregado') { statusClass = 'status-entregado'; statusText = 'En revisión'; }
          else if (entrega.estado === 'Aprobado') { statusClass = 'status-aprobado'; statusText = 'Aprobado'; }
          else if (entrega.estado === 'Reprobado') { statusClass = 'status-reprobado'; statusText = 'Reprobado'; }
        }
      %>
        <a href="/aprendiz/actividad/<%= act._id %>" class="act-card-v2">
          <div class="act-info-v2">
            <div class="act-icon-v2 <%= act.tipo %>">
              <% if (act.tipo === 'blog') { %>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              <% } else if (act.tipo === 'juego') { %>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><rect x="2" y="6" width="20" height="12" rx="2"/></svg>
              <% } else { %>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <% } %>
            </div>
            <div>
              <div class="act-meta-v2"><%= act.tipo === 'blog' ? 'Actividad escrita' : (act.tipo === 'juego' ? 'Juego' : 'Evaluación') %></div>
              <div class="act-title-v2"><%= act.titulo %></div>
            </div>
          </div>
          <div class="status-badge-v2 <%= statusClass %>" style="display: inline-flex; align-items: center; gap: 4px;">
            <% if (entrega && entrega.estado === 'Aprobado') { %>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <% } else if (entrega && entrega.estado === 'Reprobado') { %>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            <% } else if (entrega && entrega.estado === 'Entregado') { %>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/></svg>
            <% } %>
            <span><%= statusText %></span>
          </div>
        </a>
      <% }) %>
    <% } %>
  </main>
</div>
</body>
</html>
