<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .ficha-group {
      margin-bottom: 30px;
    }
    .ficha-header {
      background: var(--azul);
      color: white;
      padding: 12px 20px;
      border-top-left-radius: var(--radio);
      border-top-right-radius: var(--radio);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
    }
    .ficha-body {
      background: white;
      border: 1px solid var(--gris-borde);
      border-top: none;
      border-bottom-left-radius: var(--radio);
      border-bottom-right-radius: var(--radio);
      padding: 16px;
    }
    .select-all-label {
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      user-select: none;
    }
    .clone-row {
      display: flex;
      align-items: center;
      padding: 12px 8px;
      border-bottom: 1px solid var(--gris-borde);
      transition: background-color 0.15s;
    }
    .clone-row:last-child {
      border-bottom: none;
    }
    .clone-row:hover {
      background-color: var(--gris);
    }
    .clone-col-check {
      width: 40px;
      display: flex;
      justify-content: center;
    }
    .clone-col-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .clone-col-meta {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .custom-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: var(--verde);
    }
  </style>
</head>
<body>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Instructor' }) %>

  <nav class="sidebar">
    <% locals.currentPath = '/instructor/clonar'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'instructor' } }) %>
  </nav>

  <main class="main">
    <div class="page-header">
      <h1 class="page-title">Clonar Actividades</h1>
      <p class="page-subtitle">Copia actividades de otras fichas hacia tu ficha activa actual: <strong><%= fichaActiva.nombre %></strong></p>
    </div>

    <% if (error && error.length) { %><div class="alert alert-error"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>

    <% if (actividadesOrigen.length === 0) { %>
      <div class="card text-center" style="padding: 40px 20px;">
        <span style="font-size: 3rem; margin-bottom: 12px; display: block;">📋</span>
        <h3>No tienes actividades creadas en otras fichas.</h3>
        <p class="text-muted mt-12 mb-16">
          Para poder clonar actividades, primero debes tener actividades creadas bajo tu autoría en alguna de tus otras fichas asignadas.
        </p>
        <a href="/instructor" class="btn btn-primary">Volver al Dashboard</a>
      </div>
    <% } else { %>
      <form action="/instructor/clonar" method="POST" id="formClonar" onsubmit="return validarSeleccion(event);">
        
        <% 
          // Agrupar actividades por ficha
          const agrupadas = {};
          actividadesOrigen.forEach(act => {
            if (!act.ficha) return;
            const fId = act.ficha._id.toString();
            if (!agrupadas[fId]) {
              agrupadas[fId] = {
                nombre: act.ficha.nombre,
                codigo: act.ficha.codigo,
                actividades: []
              };
            }
            agrupadas[fId].actividades.push(act);
          });
        %>

        <% Object.keys(agrupadas).forEach(fichaId => { 
          const grupo = agrupadas[fichaId];
        %>
          <div class="ficha-group">
            <div class="ficha-header">
              <span>Ficha: <%= grupo.nombre %> (<%= grupo.codigo %>)</span>
              <label class="select-all-label">
                <input type="checkbox" class="custom-checkbox" onchange="toggleFichaGroup('<%= fichaId %>', this.checked)">
                <span>Seleccionar todo</span>
              </label>
            </div>
            <div class="ficha-body">
              <% grupo.actividades.forEach(act => { %>
                <div class="clone-row">
                  <div class="clone-col-check">
                    <input type="checkbox" name="actividadesIds" value="<%= act._id %>" class="custom-checkbox cb-act-<%= fichaId %>">
                  </div>
                  <div class="clone-col-info">
                    <div class="fw-600" style="color: var(--azul);"><%= act.titulo %></div>
                    <div style="font-size: 0.75rem; color: var(--texto-suave);">
                      Módulo: <%= act.modulo ? act.modulo.nombre : 'Sin módulo' %> | RAP: <%= act.rap ? act.rap.nombre : 'Sin RAP' %>
                    </div>
                  </div>
                  <div class="clone-col-meta">
                    <span class="badge <%= act.tipo === 'blog' ? 'badge-info' : (act.tipo === 'juego' ? 'badge-warning' : 'badge-danger') %>">
                      <%= act.tipo === 'blog' ? '📖 Blog' : (act.tipo === 'juego' ? '🎮 Juego' : '📝 Eval') %>
                    </span>
                    <span class="badge badge-gray" style="font-size: 0.7rem;"><%= act.momentoPedagogico %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>

        <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: flex-end;">
          <a href="/instructor/actividades" class="btn btn-ghost">Cancelar</a>
          <button type="submit" class="btn btn-primary">
            📋 Clonar Actividades Seleccionadas
          </button>
        </div>
      </form>
    <% } %>
  </main>
</div>

<script>
  function toggleFichaGroup(fichaId, isChecked) {
    const checkboxes = document.querySelectorAll('.cb-act-' + fichaId);
    checkboxes.forEach(cb => {
      cb.checked = isChecked;
    });
  }

  function validarSeleccion(e) {
    const checked = document.querySelectorAll('input[name="actividadesIds"]:checked');
    if (checked.length === 0) {
      alert('Por favor, selecciona al menos una actividad para clonar.');
      e.preventDefault();
      return false;
    }
    
    if (!confirm(`¿Estás seguro de clonar las ${checked.length} actividades seleccionadas a tu ficha activa actual?`)) {
      e.preventDefault();
      return false;
    }
    return true;
  }
</script>
</body>
</html>
