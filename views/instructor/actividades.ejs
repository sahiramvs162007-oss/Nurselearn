<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Instructor' }) %>

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <% locals.currentPath = '/instructor/actividades'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'instructor' } }) %>
  </nav>

  <!-- MAIN -->
  <main class="main">
    <% if (error && error.length) { %><div class="alert alert-error" style="margin-bottom: 20px;"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="alert alert-success" style="margin-bottom: 20px;"><%= success[0] %></div><% } %>

    <!-- 1. BREADCRUMBS -->
    <div class="breadcrumbs-v2">
      <a href="/instructor">Dashboard</a>
      <span class="sep">&rsaquo;</span>
      <% if (moduloSeleccionado) { %>
        <a href="/instructor/actividades">Actividades</a>
        <span class="sep">&rsaquo;</span>
        <span class="current"><%= moduloSeleccionado.modulo.nombre %></span>
      <% } else { %>
        <span class="current">Actividades</span>
      <% } %>
    </div>

    <!-- 2. CONTENEDOR DE RESUMEN (información real de la ficha) -->
    <%
      const circumference = 2 * Math.PI * 40;
      const coverageOffset = circumference - (circumference * (stats.cobertura / 100));
    %>
    <div class="rap-hero-banner-v2">
      <div class="rap-hero-wedge"></div>
      <div class="rap-hero-left">
        <h1 class="rap-hero-title">
          Gestión de Actividades — Ficha <%= fichaActiva.codigo %>
        </h1>
        <p class="rap-hero-desc">
          <%= stats.totalModulos %> módulo<%= stats.totalModulos === 1 ? '' : 's' %> ·
          <%= stats.totalRaps %> RAP<%= stats.totalRaps === 1 ? '' : 's' %> ·
          <%= stats.totalActividades %> actividad<%= stats.totalActividades === 1 ? '' : 'es' %> registrada<%= stats.totalActividades === 1 ? '' : 's' %> en esta ficha.
          Selecciona un módulo para revisar sus RAPs y administrar sus actividades.
        </p>
      </div>
      <div class="rap-hero-right">
        <div class="rap-hero-gauge">
          <svg class="rap-gauge-svg" viewBox="0 0 100 100">
            <circle class="rap-gauge-bg" cx="50" cy="50" r="40" />
            <circle class="rap-gauge-bar" cx="50" cy="50" r="40"
                    stroke-dasharray="<%= circumference %>"
                    stroke-dashoffset="<%= coverageOffset %>" />
          </svg>
          <div class="rap-gauge-text">
            <span class="pct"><%= stats.cobertura %>%</span>
            <span class="lbl">RAPs con actividad</span>
          </div>
        </div>
      </div>
    </div>

    <% if (!moduloSeleccionado) { %>
      <!-- 3. VISTA: GRID DE MÓDULOS -->
      <div class="activities-subnav-row">
        <h2 class="activities-section-title">Módulos</h2>
      </div>

      <% if (modulosConDatos.length === 0) { %>
        <div class="card text-center" style="border-radius: 20px; padding: 40px;">
          <h3>Aún no hay módulos creados.</h3>
          <p class="text-muted mt-12">Los módulos y sus RAPs los crea el administrador del sistema. En cuanto existan, podrás añadirles actividades desde aquí.</p>
        </div>
      <% } else { %>
        <div class="raps-grid-v2">
          <%
            const themes = [
              { wave: 'wave-mint', iconBox: 'icon-mint', tag: 'tag-mint', bar: 'bar-green', btn: 'btn-pill-soft' },
              { wave: 'wave-blue', iconBox: 'icon-blue', tag: 'tag-blue', bar: 'bar-blue', btn: 'btn-pill-blue' },
              { wave: 'wave-amber', iconBox: 'icon-amber', tag: 'tag-amber', bar: 'bar-amber', btn: 'btn-pill-light' },
              { wave: 'wave-purple', iconBox: 'icon-purple', tag: 'tag-purple', bar: 'bar-purple', btn: 'btn-pill-purple' },
            ];
          %>
          <% modulosConDatos.forEach((md, idx) => {
            const theme = themes[idx % themes.length];
            const rapsConActividad = md.raps.filter(r => (actividadesPorRap[r._id.toString()] || []).length > 0).length;
            const cobertura = md.raps.length > 0 ? Math.round((rapsConActividad / md.raps.length) * 100) : 0;
          %>
            <div class="rap-card-v2 module-card-v2">
              <div class="rap-card-corner-wave <%= theme.wave %>"></div>
              <div>
                <div class="rap-card-icon-box <%= theme.iconBox %>">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
                </div>
                <div class="rap-card-tag <%= theme.tag %>">MÓDULO <%= md.modulo.orden || (idx + 1) %></div>
                <h3 class="rap-card-title"><%= md.modulo.nombre %></h3>

                <!-- RAPs Y ACTIVIDADES ADENTRO DEL MÓDULO -->
                <div class="module-card-raps">
                  <div class="module-raps-header">
                    <span>RAPs y Actividades</span>
                    <span class="module-raps-count">
                      <%= md.raps.length %> <%= md.raps.length === 1 ? 'RAP' : 'RAPs' %> · <%= md.totalActividades %> <%= md.totalActividades === 1 ? 'Act' : 'Acts' %>
                    </span>
                  </div>
                  <% if (md.raps.length > 0) { %>
                    <div class="module-raps-list">
                      <% md.raps.forEach((r, rIdx) => {
                        const acts = actividadesPorRap[r._id.toString()] || [];
                        const hasActs = acts.length > 0;
                      %>
                        <div class="module-rap-group <%= hasActs ? 'has-acts' : '' %> <%= rIdx === 0 ? 'expanded' : '' %>">
                          <div class="module-rap-header" onclick="this.closest('.module-rap-group').classList.toggle('expanded')" title="Click para ver o contraer actividades de <%= r.nombre %>">
                            <span class="rap-header-icon">
                              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                            </span>
                            <span class="rap-header-title"><%= r.nombre %></span>
                            <span class="rap-header-badge"><%= acts.length %> acts</span>
                            <span class="rap-header-toggle">
                              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </span>
                          </div>

                          <div class="module-rap-activities">
                            <% if (hasActs) { %>
                              <% acts.forEach(a => { %>
                                <a href="/instructor/actividades?rap=<%= r._id %>" class="module-act-item" title="<%= a.titulo %> (<%= a.tipo %>)">
                                  <span class="module-act-icon">
                                    <% if (a.tipo === 'blog') { %>
                                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                                    <% } else if (a.tipo === 'juego') { %>
                                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><rect x="2" y="6" width="20" height="12" rx="2"/></svg>
                                    <% } else { %>
                                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                    <% } %>
                                  </span>
                                  <span class="module-act-title"><%= a.titulo %></span>
                                </a>
                              <% }) %>
                            <% } else { %>
                              <div class="module-act-empty">
                                <span>Sin actividades</span>
                                <a href="/instructor/actividades/crear?rap=<%= r._id %>" class="module-act-create-link">+ Crear</a>
                              </div>
                            <% } %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <div class="module-raps-empty">Sin RAPs asignados aún</div>
                  <% } %>
                </div>
              </div>

              <div style="margin-top: 16px;">
                <div class="rap-card-progress">
                  <div class="rap-card-progress-label">
                    <span>Cobertura de contenido</span>
                    <span style="font-weight: 700;"><%= cobertura %>%</span>
                  </div>
                  <div class="rap-card-progress-track">
                    <div class="rap-card-progress-bar <%= theme.bar %>" style="width: <%= cobertura %>%;"></div>
                  </div>
                </div>
                <a href="/instructor/actividades?modulo=<%= md.modulo._id %>" class="rap-card-btn <%= theme.btn %>">
                  Gestionar Módulo &rsaquo;
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    <% } else { %>
      <!-- 4. VISTA: DETALLE DEL MÓDULO SELECCIONADO (RAPs + trazabilidad de actividades) -->
      <a href="/instructor/actividades" class="btn btn-ghost btn-sm" style="margin-bottom: 16px;">&larr; Volver a Módulos</a>

      <div class="activities-subnav-row">
        <h2 class="activities-section-title"><%= moduloSeleccionado.modulo.nombre %></h2>
        <a href="/instructor/actividades/crear?modulo=<%= moduloSeleccionado.modulo._id %>" class="btn-create-module">
          + Crear Actividad
        </a>
      </div>

      <% if (moduloSeleccionado.raps.length === 0) { %>
        <div class="card text-center" style="border-radius: 18px; padding: 36px; background: #ffffff; border: 1.5px dashed #e2e8f0;">
          <p style="color: #64748b; font-size: 0.95rem;">Este módulo aún no tiene RAPs configurados. Contacta al administrador para crearlos.</p>
        </div>
      <% } %>

      <% moduloSeleccionado.raps.forEach((r) => {
        const acts = actividadesPorRap[r._id.toString()] || [];
        const tipoInfo = {
          blog: { label: 'Lectura', iconBox: 'icon-mint', icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>' },
          juego: { label: 'Juego', iconBox: 'icon-blue', icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="M6 12h4M8 10v4M15 11h.01M18 13h.01"/></svg>' },
          evaluacion: { label: 'Evaluación', iconBox: 'icon-purple', icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>' }
        };
      %>
        <div class="activities-subnav-row" style="margin-top: 30px; margin-bottom: 12px;<%= r._id.toString() === rapDestacadoId ? ' scroll-margin-top: 20px;' : '' %>" id="rap-<%= r._id %>">
          <h3 style="font-size: 1.05rem; font-weight: 700; color: #0f172a;">RAP <%= r.orden %>: <%= r.nombre %></h3>
          <span class="activities-est-time"><%= acts.length %> actividad<%= acts.length === 1 ? '' : 'es' %></span>
        </div>

        <% if (acts.length === 0) { %>
          <div class="card text-center" style="border-radius: 18px; padding: 30px; background: #ffffff; border: 1.5px dashed #e2e8f0; margin-bottom: 8px;">
            <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 12px;">No hay actividades registradas en este RAP todavía.</p>
            <a href="/instructor/actividades/crear?rap=<%= r._id %>" class="btn-create-module">+ Agregar Actividad</a>
          </div>
        <% } else { %>
          <div class="timeline-container-v2" style="margin-bottom: 8px;">
            <% acts.forEach((act) => {
              const ti = tipoInfo[act.tipo] || tipoInfo.blog;
            %>
              <div class="timeline-row-v2">
                <div class="timeline-node-col">
                  <div class="timeline-node">
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="#0284c7" stroke="none">
                      <polygon points="6 3 20 12 6 21 6 3"/>
                    </svg>
                  </div>
                  <div class="timeline-line"></div>
                </div>

                <div class="timeline-card-col">
                  <div class="activity-card-v2 <%= act.visible ? '' : 'act-hidden' %>" id="act-<%= act._id %>">
                    <div class="activity-card-left">
                      <div class="activity-icon-box <%= ti.iconBox %>">
                        <%- ti.icon %>
                      </div>
                      <div class="activity-card-info">
                        <h3 class="activity-card-title"><%= act.titulo %></h3>
                        <div class="activity-card-meta">
                          <span class="meta-item"><%= ti.label %></span>
                          <span class="meta-dot">&bull;</span>
                          <span class="meta-item"><%= act.momentoPedagogico %></span>
                          <% if (act.esCierreModulo) { %>
                            <span class="badge-cierre">Cierre Módulo</span>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <div class="activity-card-right">
                      <div class="instructor-quick-actions">
                        <a href="/instructor/actividades/<%= act._id %>/preview" class="icon-btn-v2" title="Vista previa como aprendiz">
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                            <circle cx="12" cy="12" r="3"/>
                          </svg>
                        </a>
                        <a href="/instructor/actividades/<%= act._id %>/editar" class="icon-btn-v2" title="Editar actividad">
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                            <path d="m15 5 4 4"/>
                          </svg>
                        </a>
                        <div class="switch-wrap" title="Visibilidad para aprendices">
                          <label class="switch">
                            <input type="checkbox" <%= act.visible ? 'checked' : '' %> onchange="toggleVisibilidad('<%= act._id %>')">
                            <span class="slider"></span>
                          </label>
                        </div>
                        <form action="/instructor/actividades/<%= act._id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar actividad?');" style="margin:0;">
                          <button type="submit" class="icon-btn-v2 delete" title="Eliminar actividad">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="3 6 5 6 21 6"/>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    <% } %>

  </main>
</div>

<script>
  async function toggleVisibilidad(id) {
    try {
      const res = await fetch('/instructor/actividades/' + id + '/visibilidad', { method: 'POST' });
      const data = await res.json();
      const el = document.getElementById('act-' + id);
      if (data.visible) {
        el.classList.remove('act-hidden');
      } else {
        el.classList.add('act-hidden');
      }
    } catch (e) {
      alert('Error al cambiar visibilidad');
      window.location.reload();
    }
  }

  // Si viene de un enlace con ?rap=ID, hace scroll hasta ese RAP dentro del módulo
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const rapId = urlParams.get('rap');
    if (rapId) {
      const el = document.getElementById('rap-' + rapId);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  })();
</script>
</body>
</html>
