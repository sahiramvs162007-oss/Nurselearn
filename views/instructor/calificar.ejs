<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .entrega-box { border: 1px solid var(--gris-borde); border-radius: 12px; background: var(--gris); padding: 24px; margin-bottom: 24px; }
    .entrega-header { font-weight: 600; color: var(--azul); font-size: 1.1rem; border-bottom: 1px solid var(--gris-borde); padding-bottom: 12px; margin-bottom: 16px; }
    .contenido-texto { background: white; padding: 16px; border-radius: 8px; border: 1px solid var(--gris-borde); min-height: 100px; white-space: pre-wrap; font-size: 0.95rem; }
    .archivo-link { display: inline-flex; align-items: center; gap: 8px; background: white; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--verde); color: var(--verde-oscuro); text-decoration: none; font-weight: 600; transition: all 0.2s; }
    .archivo-link:hover { background: var(--verde-claro); transform: translateY(-2px); box-shadow: var(--sombra); }
    .eval-panel { background: white; border: 1px solid var(--gris-borde); border-radius: 12px; padding: 24px; box-shadow: var(--sombra); border-top: 4px solid var(--azul); }
    .resultado-grande { font-size: 2.4rem; font-weight: 800; text-align: center; }
    .pregunta-revision { border: 1px solid var(--gris-borde); border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; background: white; }
    .pregunta-revision .opcion { padding: 6px 10px; border-radius: 6px; font-size: 0.9rem; margin-top: 4px; }
    .pregunta-revision .opcion.correcta { background: #dcfce7; color: #15803d; font-weight: 600; }
    .pregunta-revision .opcion.elegida-incorrecta { background: #fee2e2; color: #991b1b; font-weight: 600; }
  </style>
</head>
<body>
<div class="layout">
  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Instructor' }) %>

  <nav class="sidebar">
    <%- include('../partials/sidebar', { session: { userRol: 'instructor' } }) %>
  </nav>

  <main class="main">
    <div class="page-header flex-between">
      <div>
        <h1 class="page-title"><%= titulo %></h1>
        <p class="page-subtitle">Revisión de la entrega realizada por el aprendiz.</p>
      </div>
      <a href="/instructor/entregas" class="btn btn-ghost">← Volver al listado</a>
    </div>

    <% if (error && error.length) { %><div class="alert alert-error"><%= error[0] %></div><% } %>

    <% if (entrega.actividad.tipo === 'blog') { %>
    <div class="grid-2">
      <!-- PANEL DE LA ENTREGA DEL APRENDIZ -->
      <div>
        <div class="entrega-box">
          <div class="entrega-header flex-between">
            <span>🎓 <%= entrega.aprendiz.nombre %></span>
            <span class="badge badge-info">Intento #<%= entrega.intentos %></span>
          </div>

          <div class="mb-16">
            <strong>Actividad:</strong> <%= entrega.actividad.titulo %><br>
            <span class="text-muted">Fecha de envío: <%= entrega.entregadoEn ? entrega.entregadoEn.toLocaleString() : 'Desconocida' %></span>
          </div>

          <% if (entrega.respuestaTexto) { %>
            <div class="mb-16">
              <label style="font-size: 0.85rem; font-weight: 600; color: var(--texto-suave); display: block; margin-bottom: 8px; text-transform: uppercase;">Respuesta en texto:</label>
              <div class="contenido-texto"><%= entrega.respuestaTexto %></div>
            </div>
          <% } %>

          <% if (entrega.archivoUrl) { %>
            <div>
              <label style="font-size: 0.85rem; font-weight: 600; color: var(--texto-suave); display: block; margin-bottom: 8px; text-transform: uppercase;">Archivo adjunto:</label>
              <a href="<%= entrega.archivoUrl %>" target="_blank" class="archivo-link">
                <span style="font-size: 1.2rem;">📎</span> Ver o descargar archivo
              </a>
            </div>
          <% } %>

          <% if (!entrega.respuestaTexto && !entrega.archivoUrl) { %>
            <div class="alert alert-warning">El aprendiz marcó la actividad como completada pero no adjuntó texto ni archivos.</div>
          <% } %>
        </div>
      </div>

      <!-- PANEL DE EVALUACIÓN -->
      <div>
        <div class="eval-panel">
          <div class="card-title">Panel de Calificación</div>
          <form action="/instructor/entregas/<%= entrega._id %>/calificar" method="POST">

            <div class="form-group">
              <label>Porcentaje de Calificación (0 - 100)</label>
              <div style="display: flex; align-items: center; gap: 10px;">
                <input type="number" name="porcentaje" required min="0" max="100" value="<%= entrega.porcentaje !== null && entrega.porcentaje !== undefined ? entrega.porcentaje : '' %>" style="font-size: 1.5rem; font-family: var(--mono); font-weight: 700; color: var(--azul); width: 100px; text-align: center;" placeholder="0">
                <span style="font-size: 1.5rem; color: var(--texto-suave); font-weight: 700;">%</span>
              </div>
              <p class="text-muted mt-12">Recuerda: 70% o más aprueba la actividad automáticamente.</p>
            </div>

            <div class="form-group" style="margin-top: 24px;">
              <label>Retroalimentación para el aprendiz</label>
              <textarea name="retroalimentacion" rows="5" required placeholder="Escribe tus comentarios, correcciones o felicitaciones aquí..."><%= entrega.retroalimentacion || '' %></textarea>
            </div>

            <div class="form-group switch-wrap" style="background: var(--gris); padding: 16px; border-radius: 8px; border: 1px solid var(--gris-borde); margin-top: 24px;">
              <label class="switch">
                <input type="checkbox" name="habilitarSegundoIntento" id="segundoIntentoCheck">
                <span class="slider"></span>
              </label>
              <div style="display: flex; flex-direction: column;">
                <span style="font-weight: 600; color: var(--texto);">Habilitar Segundo Intento</span>
                <span class="text-muted" style="font-size: 0.75rem;">Si habilitas esta opción y la nota es menor a 70%, el aprendiz podrá corregir y volver a enviar su entrega.</span>
              </div>
            </div>

            <button type="submit" class="btn btn-primary mt-20 w-100" style="padding: 14px; font-size: 1rem;">Guardar Calificación</button>
          </form>
        </div>
      </div>

    </div>

    <% } else { %>
    <!-- ══ VISTA DE SOLO LECTURA: JUEGO / EVALUACIÓN (calificados automáticamente) ══ -->
    <div class="grid-2">
      <div>
        <div class="entrega-box">
          <div class="entrega-header flex-between">
            <span>🎓 <%= entrega.aprendiz.nombre %></span>
            <span class="badge badge-info">Intento #<%= entrega.intentos %></span>
          </div>

          <div class="mb-16">
            <strong>Actividad:</strong> <%= entrega.actividad.titulo %>
            <span class="badge badge-gray" style="margin-left: 8px;"><%= entrega.actividad.tipo === 'juego' ? 'Juego' : 'Evaluación' %></span><br>
            <span class="text-muted">Fecha de envío: <%= entrega.entregadoEn ? entrega.entregadoEn.toLocaleString() : 'Desconocida' %></span>
          </div>

          <% if (entrega.actividad.tipo === 'evaluacion' && entrega.actividad.preguntas && entrega.actividad.preguntas.length) { %>
            <label style="font-size: 0.85rem; font-weight: 600; color: var(--texto-suave); display: block; margin-bottom: 8px; text-transform: uppercase;">Respuestas del aprendiz:</label>
            <% entrega.actividad.preguntas.forEach((p, i) => {
              const respuestaDada = (entrega.respuestasEval || [])[i];
            %>
              <div class="pregunta-revision">
                <strong><%= i + 1 %>. <%= p.enunciado %></strong>
                <% p.opciones.forEach((op, j) => {
                  let cls = '';
                  if (j === p.respuestaCorrecta) cls = 'correcta';
                  else if (j === respuestaDada) cls = 'elegida-incorrecta';
                %>
                  <div class="opcion <%= cls %>">
                    <%= op %>
                    <% if (j === respuestaDada) { %> <em>(respuesta del aprendiz)</em><% } %>
                    <% if (j === p.respuestaCorrecta) { %> ✓<% } %>
                  </div>
                <% }) %>
              </div>
            <% }) %>
          <% } else if (entrega.actividad.tipo === 'juego') { %>
            <label style="font-size: 0.85rem; font-weight: 600; color: var(--texto-suave); display: block; margin-bottom: 8px; text-transform: uppercase;">Resultado del juego:</label>
            <div class="contenido-texto">
              El aprendiz completó "<%= entrega.actividad.titulo %>" con un resultado de <strong><%= entrega.porcentaje %>%</strong>.
            </div>
          <% } %>

          <% if (entrega.retroalimentacion) { %>
            <div class="mt-16">
              <label style="font-size: 0.85rem; font-weight: 600; color: var(--texto-suave); display: block; margin-bottom: 8px; text-transform: uppercase;">Nota del sistema:</label>
              <div class="contenido-texto"><%= entrega.retroalimentacion %></div>
            </div>
          <% } %>
        </div>
      </div>

      <div>
        <div class="eval-panel">
          <div class="card-title">Calificación automática</div>
          <p class="text-muted mb-16">Esta actividad se corrige automáticamente al momento de la entrega. No requiere calificación manual del instructor.</p>
          <div class="resultado-grande" style="color: <%= entrega.estado === 'Aprobado' ? '#15803d' : (entrega.estado === 'Reprobado' ? '#991b1b' : '#64748b') %>;">
            <%= entrega.porcentaje !== null && entrega.porcentaje !== undefined ? entrega.porcentaje + '%' : '—' %>
          </div>
          <div style="text-align:center; margin-top: 8px;">
            <% if (entrega.estado === 'Aprobado') { %>
              <span class="status-badge-v2 status-aprobado">Aprobado</span>
            <% } else if (entrega.estado === 'Reprobado') { %>
              <span class="status-badge-v2 status-reprobado">Reprobado</span>
            <% } else { %>
              <span class="status-badge-v2 status-pendiente">Sin resultado</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </main>
</div>

<script>
  const inputNota = document.querySelector('input[name="porcentaje"]');
  const checkIntento = document.getElementById('segundoIntentoCheck');

  if (inputNota && checkIntento) {
    inputNota.addEventListener('input', (e) => {
      if (parseInt(e.target.value) >= 70) {
        checkIntento.disabled = true;
        checkIntento.checked = false;
        checkIntento.closest('.form-group').style.opacity = '0.5';
      } else {
        checkIntento.disabled = false;
        checkIntento.closest('.form-group').style.opacity = '1';
      }
    });
  }
</script>
</body>
</html>
