<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css?v=2">
</head>
<body>
<div class="login-wrapper">
  <!-- Cabecera / Navegación superior -->
  <header class="login-header">
    <a href="#" class="login-header-logo">Nurse<span>Learn</span></a>
    <nav class="login-nav-links">
      <a href="#" class="active">Inicio</a>
      <a href="#">Sobre el Sistema</a>
    </nav>
    <a href="https://www.sena.edu.co" target="_blank" class="btn-top-sena">SENA</a>
  </header>

  <!-- Contenido Principal (Héroe) -->
  <main class="login-main">
    <!-- Lado Izquierdo: Textos -->
    <div class="login-content-left">
      <div class="badge-medical">Hospital & Aprendizaje</div>
      <h1 class="main-title">
        English Skills <span>for Future &</span> <br><span>Nurses</span>
      </h1>
      <p class="main-desc">
        Desarrolla competencias en inglés para el sector salud mediante una plataforma interactiva, práctica y diseñada para fortalecer tu desempeño profesional.
      </p>
      
      <div class="cta-actions">
        <a href="#login-form" class="btn-get-started">Comenzar Ahora <span class="arrow">›</span></a>
        <div class="emergency-contact">
          <div class="contact-icon">📞</div>
          <div class="contact-text">
            <span>Mesa de Ayuda</span>
            <strong>+57 (601) 546-1500</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Lado Derecho: Imagen de Enfermera y Tarjetas Flotantes -->
    <div class="login-content-right">
      <img src="/img/enfermera.png" alt="Enfermera NurseLearn" class="nurse-img">
      
      <!-- Tarjeta Flotante 1 -->
      <div class="info-card card-instructor animate-float-delay-1">
        <div class="avatar">👩‍⚕️</div>
        <div class="details">
          <strong>Expert Instructors</strong>
          <span>Personalized guidance</span>
        </div>
      </div>
      
      <!-- Tarjeta Flotante 2 -->
      <div class="info-card card-users animate-float-delay-2">
        <div class="avatars-group">
          <div class="avatar-sm">👤</div>
          <div class="avatar-sm">👤</div>
          <div class="avatar-sm">👤</div>
        </div>
        <div class="details">
          <strong>+500 Active</strong>
          <span>Learners Learning every day</span>
        </div>
      </div>
    </div>
  </main>

  <!-- Barra de Login Inferior (Glassmorphism) -->
  <div class="login-bar-container">
    <% if (error && error.length) { %>
      <div class="alert alert-error login-alert">⚠️ <%= error[0] %></div>
    <% } %>
    <% if (success && success.length) { %>
      <div class="alert alert-success login-alert">✅ <%= success[0] %></div>
    <% } %>

    <form id="login-form" action="/auth/login" method="POST" class="login-bar-form">
      <div class="bar-input-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" required placeholder="correo@sena.edu.co" autofocus autocomplete="email">
      </div>
      
      <div class="bar-input-group">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password">
      </div>

      <div class="bar-submit-group">
        <button type="submit" class="btn-login-submit">
          Ingresar al Sistema
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnGetStarted = document.querySelector('.btn-get-started');
    const loginBar = document.querySelector('.login-bar-container');
    const emailInput = document.getElementById('email');

    // Si existen mensajes de error o éxito al recargar, la barra se muestra de inmediato
    const hasAlert = document.querySelector('.login-alert');
    if (hasAlert) {
      loginBar.classList.add('show');
    }

    btnGetStarted.addEventListener('click', (e) => {
      e.preventDefault();
      loginBar.classList.add('show');
      
      // Desplazamiento suave para asegurar la visualización en pantallas pequeñas
      loginBar.scrollIntoView({ behavior: 'smooth', block: 'end' });
      
      // Enfocar campo de correo electrónico
      setTimeout(() => {
        emailInput.focus();
      }, 500);
    });
  });
</script>
</body>
</html>
