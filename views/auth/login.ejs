<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css?v=2">
</head>
<body>
<div class="login-wrapper">
  <!-- Cabecera / Navegación superior -->
  <header class="login-header">
    <a href="#" class="login-header-logo">Nurse<span>Learn</span></a>
    <nav class="login-nav-links">
      <a href="#" class="active">Inicio</a>
      <a href="#">Sobre el Sistema</a>
    </nav>
    <a href="https://www.sena.edu.co" target="_blank" class="btn-top-sena">SENA</a>
  </header>

  <!-- Contenido Principal (Héroe) -->
  <main class="login-main">
    <!-- Lado Izquierdo: Contenido Dinámico -->
    <div class="login-content-left">
      
      <!-- Bloque 1: Bienvenida (Visible por defecto) -->
      <div class="login-intro-block">
        <div class="badge-medical">Hospital & Aprendizaje</div>
        <h1 class="main-title">
          English Skills <span>for Future &</span> <br><span>Nurses</span>
        </h1>
        <p class="main-desc">
          Desarrolla competencias en inglés para el sector salud mediante una plataforma interactiva, práctica y diseñada para fortalecer tu desempeño profesional.
        </p>
        
        <div class="cta-actions">
          <button class="btn-get-started">Comenzar Ahora <span class="arrow">›</span></button>
          <div class="emergency-contact">
            <div class="contact-icon">📞</div>
            <div class="contact-text">
              <span>Mesa de Ayuda</span>
              <strong>+57 (601) 546-1500</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Bloque 2: Formulario de Login (Oculto por defecto, reemplaza al Bloque 1) -->
      <div class="login-form-block" style="display: none;">
        <% if (error && error.length) { %>
          <div class="alert alert-error login-alert">⚠️ <%= error[0] %></div>
        <% } %>
        <% if (success && success.length) { %>
          <div class="alert alert-success login-alert">✅ <%= success[0] %></div>
        <% } %>

        <div class="login-box">
          <h2 class="login-box-title">Iniciar Sesión</h2>
          <p class="login-box-subtitle">Ingresa tus credenciales para acceder a la plataforma</p>

          <form id="login-form" action="/auth/login" method="POST">
            <div class="form-group">
              <label for="email">Correo electrónico</label>
              <input type="email" id="email" name="email" required placeholder="correo@sena.edu.co" autocomplete="email">
            </div>
            
            <div class="form-group" style="margin-bottom: 25px;">
              <label for="password">Contraseña</label>
              <input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password">
            </div>

            <button type="submit" class="btn-login-submit">
              Ingresar al Sistema
            </button>
          </form>

          <button class="btn-back-intro">
            ← Volver al inicio
          </button>
        </div>
      </div>

    </div>

    <!-- Lado Derecho: Imagen de Enfermera y Tarjetas Flotantes -->
    <div class="login-content-right">
      <img src="/img/enfermera.png" alt="Enfermera NurseLearn" class="nurse-img">
      
      <!-- Tarjeta Flotante 1 -->
      <div class="info-card card-instructor animate-float-delay-1">
        <div class="avatar">👩‍⚕️</div>
        <div class="details">
          <strong>Expert Instructors</strong>
          <span>Personalized guidance</span>
        </div>
      </div>
      
      <!-- Tarjeta Flotante 2 -->
      <div class="info-card card-users animate-float-delay-2">
        <div class="avatars-group">
          <div class="avatar-sm">👤</div>
          <div class="avatar-sm">👤</div>
          <div class="avatar-sm">👤</div>
        </div>
        <div class="details">
          <strong>+500 Active</strong>
          <span>Learners Learning every day</span>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnGetStarted = document.querySelector('.btn-get-started');
    const btnBackIntro = document.querySelector('.btn-back-intro');
    const introBlock = document.querySelector('.login-intro-block');
    const formBlock = document.querySelector('.login-form-block');
    const emailInput = document.getElementById('email');

    // Función para ocultar intro y mostrar formulario
    const showLoginForm = () => {
      introBlock.classList.add('hide');
      setTimeout(() => {
        introBlock.style.display = 'none';
        formBlock.style.display = 'block';
        setTimeout(() => {
          formBlock.classList.add('show');
          emailInput.focus();
        }, 50);
      }, 400);
    };

    // Función para ocultar formulario y mostrar intro
    const showIntroText = () => {
      formBlock.classList.remove('show');
      setTimeout(() => {
        formBlock.style.display = 'none';
        introBlock.style.display = 'block';
        setTimeout(() => {
          introBlock.classList.remove('hide');
        }, 50);
      }, 400);
    };

    // Si existen mensajes de error o éxito al recargar, se muestra el formulario de inmediato
    const hasAlert = document.querySelector('.login-alert');
    if (hasAlert) {
      introBlock.style.display = 'none';
      introBlock.classList.add('hide');
      formBlock.style.display = 'block';
      formBlock.classList.add('show');
    }

    btnGetStarted.addEventListener('click', (e) => {
      e.preventDefault();
      showLoginForm();
    });

    btnBackIntro.addEventListener('click', (e) => {
      e.preventDefault();
      showIntroText();
    });
  });
</script>
</body>
</html>
