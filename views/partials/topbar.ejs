<header class="topbar">
  <div class="topbar-portal-title">SENA Nursing English</div>
  <div class="topbar-right">
    <a href="/notificaciones" class="topbar-icon-btn" title="Notificaciones" style="text-decoration: none;">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
    </a>

    <div class="user-avatar-pill">
      <% 
        const rawUser = locals.user || (locals.session && locals.session.userName) || 'Usuario';
        const rawRol = locals.userRol || (locals.session && locals.session.userRol ? locals.session.userRol.toUpperCase() : 'INSTRUCTOR');
        const initials = rawUser.trim().split(/\s+/).filter(Boolean).map(n => n[0]).join('').substring(0,2).toUpperCase() || 'U';
      %>
      <div class="user-avatar-circle"><%= initials %></div>
      <div class="user-avatar-info">
        <span class="user-avatar-name"><%= rawUser %></span>
        <span class="user-avatar-rol"><%= rawRol %></span>
      </div>
    </div>
  </div>
</header>

