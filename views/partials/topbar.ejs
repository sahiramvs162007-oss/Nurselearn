<header class="topbar">
  <div class="flex gap-12" style="align-items: center;">
    <div style="width: 36px; height: 36px; border-radius: 10px; background: #e6f7ef; border: 1.5px solid #a3e0c4; display: flex; align-items: center; justify-content: center; color: #006b47; flex-shrink: 0;">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 3v5a5 5 0 0 0 10 0V3"/>
        <path d="M9 13v3a4 4 0 0 0 8 0v-3"/>
        <circle cx="17" cy="10" r="3"/>
      </svg>
    </div>
    <div class="topbar-portal-title" style="font-weight: 700; font-size: 1.05rem; color: var(--texto);">
      Nursing English
    </div>
  </div>

  <div class="topbar-right">
    <a href="/notificaciones" id="topbarBellBtn" class="topbar-icon-btn" title="Notificaciones" style="text-decoration: none; position: relative;">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
        <span id="topbarBellBadge" style="position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: #ef4444;"></span>
      <% } else { %>
        <span id="topbarBellBadge" style="position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: #ef4444; display: none;"></span>
      <% } %>
    </a>


    <div class="user-avatar-pill">
      <% 
        const rawUser = locals.user || (locals.session && locals.session.userName) || 'Usuario';
        const rawRol = locals.userRol || (locals.session && locals.session.userRol ? locals.session.userRol.toUpperCase() : 'INSTRUCTOR');
        const initials = rawUser.trim().split(/\s+/).filter(Boolean).map(n => n[0]).join('').substring(0,2).toUpperCase() || 'U';
      %>
      <div class="user-avatar-circle" style="background: #00593B;"><%= initials %></div>
      <div class="user-avatar-info">
        <span class="user-avatar-name"><%= rawUser %></span>
        <span class="user-avatar-rol"><%= rawRol %></span>
      </div>
    </div>
  </div>
</header>

<!-- Modal emergente para Notificaciones desde la Campana -->
<div id="notifModalBackdrop" class="notif-modal-backdrop" aria-hidden="true">
  <div class="notif-modal-dialog" role="dialog" aria-labelledby="notifModalTitle" aria-modal="true">
    <div class="notif-modal-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #00593B;">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <h3 id="notifModalTitle" style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #111827;">Notificaciones</h3>
        <span id="notifModalBadge" style="display: none; background: #e0f2fe; color: #0284c7; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 9999px;"></span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <button type="button" id="notifModalMarkAllBtn" style="background: none; border: none; color: #00593B; font-size: 0.8rem; font-weight: 600; cursor: pointer; padding: 4px 8px; border-radius: 6px;" title="Marcar todas como leídas">Marcar todas</button>
        <button type="button" id="notifModalCloseBtn" class="notif-close-btn" aria-label="Cerrar modal">&times;</button>
      </div>
    </div>
    <div id="notifModalBody" class="notif-modal-body">
      <div style="text-align: center; padding: 30px 10px; color: #6b7280;">
        Cargando notificaciones...
      </div>
    </div>
    <div class="notif-modal-footer">
      <a href="/notificaciones" class="notif-footer-link">Ver todas las notificaciones &rarr;</a>
    </div>
  </div>
</div>

<script>
  (function() {
    const bellBtn = document.getElementById('topbarBellBtn');
    const backdrop = document.getElementById('notifModalBackdrop');
    const closeBtn = document.getElementById('notifModalCloseBtn');
    const modalBody = document.getElementById('notifModalBody');
    const modalBadge = document.getElementById('notifModalBadge');
    const markAllBtn = document.getElementById('notifModalMarkAllBtn');
    const bellBadge = document.getElementById('topbarBellBadge');

    if (!bellBtn || !backdrop) return;

    function openModal() {
      backdrop.classList.add('active');
      backdrop.setAttribute('aria-hidden', 'false');
      loadNotifications();
    }

    function closeModal() {
      backdrop.classList.remove('active');
      backdrop.setAttribute('aria-hidden', 'true');
    }

    bellBtn.addEventListener('click', function(e) {
      e.preventDefault();
      openModal();
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    backdrop.addEventListener('click', function(e) {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && backdrop.classList.contains('active')) {
        closeModal();
      }
    });

    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        const d = new Date(dateStr);
        return d.toLocaleDateString('es-CO', { 
          month: 'short', 
          day: 'numeric', 
          hour: '2-digit', 
          minute: '2-digit' 
        });
      } catch (err) {
        return dateStr;
      }
    }

    async function loadNotifications() {
      modalBody.innerHTML = '<div style="text-align:center; padding:30px 10px; color:#6b7280;"><span class="spinner" style="display:inline-block; width:20px; height:20px; border:2px solid #00593B; border-top-color:transparent; border-radius:50%; animation:spin 0.8s linear infinite;"></span><div style="margin-top:8px;">Cargando notificaciones...</div></div>';

      try {
        const res = await fetch('/notificaciones?json=true');
        if (!res.ok) throw new Error('Error al cargar');
        const data = await res.json();
        renderNotifications(data.notifications || [], data.unreadCount || 0);
      } catch (err) {
        modalBody.innerHTML = '<div style="text-align:center; padding:30px 10px; color:#ef4444;">No se pudieron cargar las notificaciones.</div>';
      }
    }

    function renderNotifications(notifs, unreadCount) {
      if (unreadCount > 0) {
        modalBadge.textContent = unreadCount + ' nueva' + (unreadCount > 1 ? 's' : '');
        modalBadge.style.display = 'inline-block';
        if (bellBadge) bellBadge.style.display = 'inline-block';
      } else {
        modalBadge.style.display = 'none';
        if (bellBadge) bellBadge.style.display = 'none';
      }

      if (!notifs || notifs.length === 0) {
        modalBody.innerHTML = `
          <div class="notif-empty-state">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <p style="margin: 8px 0 0 0; font-size: 0.95rem; font-weight: 600; color: #374151;">No tienes notificaciones</p>
            <p style="margin: 4px 0 0 0; font-size: 0.82rem; color: #9ca3af;">Te avisaremos cuando haya novedades en tus actividades.</p>
          </div>
        `;
        return;
      }

      let html = '';
      notifs.forEach(function(n) {
        const isUnread = !n.leida;
        const typeClass = 'notif-type-' + (n.tipo || 'info').toLowerCase();
        html += `
          <div class="notif-item ${isUnread ? 'unread' : ''}" data-id="${n.id_notificacion}">
            <div class="notif-item-top">
              <div class="notif-item-title-wrap">
                <span class="notif-type-tag ${typeClass}">${escapeHtml(n.tipo || 'Aviso')}</span>
                ${isUnread ? '<span class="notif-badge-new">Nueva</span>' : ''}
              </div>
              <span class="notif-item-time">${formatDate(n.fecha_creacion)}</span>
            </div>
            <div class="notif-item-msg">${escapeHtml(n.mensaje)}</div>
            <div class="notif-item-actions">
              ${isUnread ? `<button type="button" class="notif-action-btn mark-single-btn" data-id="${n.id_notificacion}">Marcar como leída</button>` : ''}
              ${n.enlace ? `<a href="${escapeHtml(n.enlace)}" class="notif-action-btn" style="text-decoration:none;">Ir al detalle &rarr;</a>` : ''}
            </div>
          </div>
        `;
      });

      modalBody.innerHTML = html;

      // Listeners para botones de marcar como leída individual
      modalBody.querySelectorAll('.mark-single-btn').forEach(btn => {
        btn.addEventListener('click', async function(e) {
          e.stopPropagation();
          const id = this.getAttribute('data-id');
          await markAsRead(id);
        });
      });
    }

    async function markAsRead(id) {
      try {
        const res = await fetch('/notificaciones/' + id + '/leido?json=true', { method: 'POST' });
        if (res.ok) {
          loadNotifications();
        }
      } catch (err) {
        console.error('Error al marcar leída:', err);
      }
    }

    if (markAllBtn) {
      markAllBtn.addEventListener('click', async function() {
        try {
          const res = await fetch('/notificaciones/marcar-todo?json=true', { method: 'POST' });
          if (res.ok) {
            loadNotifications();
          }
        } catch (err) {
          console.error('Error al marcar todo como leído:', err);
        }
      });
    }
  })();
</script>
