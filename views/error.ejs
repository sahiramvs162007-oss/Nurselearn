<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Error — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css?v=14">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
</head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:var(--gris);">
  <div class="card" style="max-width:480px;text-align:center;padding:40px;">
    <div style="font-size:3rem;margin-bottom:16px;">⚠️</div>
    <h1 class="page-title" style="margin-bottom:8px;"><%= titulo || 'Error' %></h1>
    <p class="text-muted"><%= mensaje || 'Ocurrió un error inesperado.' %></p>
    <a href="/" class="btn btn-primary" style="margin-top:24px;">Ir al inicio</a>
  </div>
