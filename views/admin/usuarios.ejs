<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css?v=14">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
</head>
<body>
<div class="layout">
  <!-- SIDEBAR -->
  <nav class="sidebar">
    <% locals.currentPath = '/admin/usuarios'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'admin' } }) %>
  </nav>

  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Administrador' }) %>

  <!-- MAIN -->
  <main class="main">
    <div class="page-header-container">
      <div>
        <div class="page-category-label">Management Console</div>
        <h1 class="page-title">User Directory</h1>
        <p class="page-subtitle">Oversee and manage the access levels of students and clinical instructors within the Nursing English portal.</p>
      </div>
      <div class="page-header-actions">
        <button class="btn btn-secondary" style="border-radius: var(--radio-pill);" onclick="document.getElementById('modal-crear').style.display='flex'">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add New User
        </button>
      </div>
    </div>

    <% if (error && error.length) { %><div class="alert alert-error"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>

    <div class="card-table-container" style="margin-top:0;">
      <div class="table-toolbar">
        <div class="search-input-pill">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" placeholder="Search by name, email or ID...">
        </div>

        <button class="btn-filter-pill">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
          </svg>
          Filter
        </button>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% usuarios.forEach((u, i) => { 
              const uInit = u.nombre.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase();
              const colors = ['#0284c7', '#0d9488', '#e11d48', '#d97706', '#7c3aed'];
              const bgCol = colors[i % colors.length];
              const roleClass = u.rol === 'admin' ? 'badge-role-admin' : u.rol === 'instructor' ? 'badge-role-instructor' : 'badge-role-student';
            %>
            <tr>
              <td>
                <div class="user-cell">
                  <div class="user-cell-avatar" style="background: <%= bgCol %>; color: white;">
                    <%= uInit %>
                  </div>
                  <div class="user-cell-info">
                    <span class="user-cell-name"><%= u.nombre %></span>
                    <span class="user-cell-sub">ID SENA-<%= String(u._id).substring(18,24).toUpperCase() %></span>
                  </div>
                </div>
              </td>
              <td style="color: var(--texto-suave);"><%= u.email %></td>
              <td>
                <span class="badge-role <%= roleClass %>">
                  <%= u.rol === 'aprendiz' ? 'STUDENT' : u.rol.toUpperCase() %>
                </span>
              </td>
              <td>
                <span class="status-pill">
                  <span class="status-dot <%= (u.estado || 'Activo') === 'Activo' ? 'active' : 'inactive' %>"></span>
                  <%= (u.estado || 'Activo') === 'Activo' ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <button class="btn btn-sm btn-ghost" onclick='editarUsuario(<%= JSON.stringify(u) %>)' title="Editar">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                  </button>
                  <form action="/admin/usuarios/<%= u._id %>/eliminar" method="POST" style="display:inline"
                    onsubmit="return confirm('¿Eliminar usuario?')">
                    <button class="btn btn-sm btn-ghost" style="color:var(--rojo);" title="Eliminar">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                      </svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- MODAL CREAR -->
    <div id="modal-crear" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:200;align-items:center;justify-content:center;">
      <div class="card" style="width:480px;max-height:90vh;overflow-y:auto;">
        <div class="flex-between mb-16">
          <div class="card-title" style="border:none;padding:0;margin:0">Crear usuario</div>
          <button class="btn btn-sm btn-ghost" onclick="document.getElementById('modal-crear').style.display='none'">✕</button>
        </div>
        <form action="/admin/usuarios" method="POST">
          <div class="form-group"><label>Nombre</label><input name="nombre" required></div>
          <div class="form-group"><label>Email</label><input type="email" name="email" required></div>
          <div class="form-group"><label>Contraseña</label><input type="password" name="password" required></div>
          <div class="form-group">
            <label>Rol</label>
            <select name="rol">
              <option value="aprendiz">Aprendiz</option>
              <option value="instructor">Instructor</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100" style="justify-content:center;">Crear</button>
        </form>
      </div>
    </div>

    <!-- MODAL EDITAR -->
    <div id="modal-editar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:200;align-items:center;justify-content:center;">
      <div class="card" style="width:480px;">
        <div class="flex-between mb-16">
          <div class="card-title" style="border:none;padding:0;margin:0">Editar usuario</div>
          <button class="btn btn-sm btn-ghost" onclick="document.getElementById('modal-editar').style.display='none'">✕</button>
        </div>
        <form id="form-editar" method="POST">
          <div class="form-group"><label>Nombre</label><input name="nombre" id="edit-nombre" required></div>
          <div class="form-group"><label>Email</label><input type="email" name="email" id="edit-email" required></div>
          <div class="form-group">
            <label>Rol</label>
            <select name="rol" id="edit-rol">
              <option value="aprendiz">Aprendiz</option>
              <option value="instructor">Instructor</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div class="form-group">
            <label>Estado (aprendices)</label>
            <select name="estado" id="edit-estado">
              <option value="Activo">Activo</option>
              <option value="Certificado">Certificado</option>
              <option value="Inactivo">Inactivo</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100" style="justify-content:center;">Guardar</button>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
function editarUsuario(u) {
  document.getElementById('edit-nombre').value = u.nombre;
  document.getElementById('edit-email').value = u.email;
  document.getElementById('edit-rol').value = u.rol;
  document.getElementById('edit-estado').value = u.estado || 'Activo';
  document.getElementById('form-editar').action = '/admin/usuarios/' + u._id + '/editar';
  document.getElementById('modal-editar').style.display = 'flex';
}
</script>
</body>
</html>
