<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — SENA Inglés</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="layout">
  <header class="topbar">
    <a href="/admin" class="topbar-logo">SENA <span>Inglés</span></a>
    <div class="topbar-spacer"></div>
    <div class="topbar-user"><span><%= user %></span><span class="topbar-rol">Admin</span></div>
  </header>
  <nav class="sidebar">
    <%- include('../partials/sidebar', { session: { userRol: 'admin' }, locals: { currentPath: '/admin/usuarios' } }) %>
  </nav>
  <main class="main">
    <div class="page-header flex-between">
      <div>
        <h1 class="page-title">Usuarios</h1>
        <p class="page-subtitle">Instructores y aprendices del sistema</p>
      </div>
      <button class="btn btn-primary" onclick="document.getElementById('modal-crear').style.display='flex'">
        + Nuevo usuario
      </button>
    </div>

    <% if (error && error.length) { %><div class="alert alert-error"><%= error[0] %></div><% } %>
    <% if (success && success.length) { %><div class="alert alert-success"><%= success[0] %></div><% } %>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr>
          </thead>
          <tbody>
            <% usuarios.forEach(u => { %>
            <tr>
              <td class="fw-600"><%= u.nombre %></td>
              <td class="text-muted"><%= u.email %></td>
              <td>
                <span class="badge <%= u.rol === 'admin' ? 'badge-info' : u.rol === 'instructor' ? 'badge-warning' : 'badge-success' %>">
                  <%= u.rol %>
                </span>
              </td>
              <td>
                <% if (u.estado) { %>
                  <span class="badge <%= u.estado === 'Activo' ? 'badge-success' : u.estado === 'Certificado' ? 'badge-info' : 'badge-danger' %>">
                    <%= u.estado %>
                  </span>
                <% } else { %>—<% } %>
              </td>
              <td class="flex gap-8">
                <button class="btn btn-sm btn-ghost" onclick='editarUsuario(<%= JSON.stringify(u) %>)'>✏️</button>
                <form action="/admin/usuarios/<%= u._id %>/eliminar" method="POST" style="display:inline"
                  onsubmit="return confirm('¿Eliminar usuario?')">
                  <button class="btn btn-sm btn-danger">🗑️</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- MODAL CREAR -->
    <div id="modal-crear" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:200;align-items:center;justify-content:center;">
      <div class="card" style="width:480px;max-height:90vh;overflow-y:auto;">
        <div class="flex-between mb-16">
          <div class="card-title" style="border:none;padding:0;margin:0">Crear usuario</div>
          <button class="btn btn-sm btn-ghost" onclick="document.getElementById('modal-crear').style.display='none'">✕</button>
        </div>
        <form action="/admin/usuarios" method="POST">
          <div class="form-group"><label>Nombre</label><input name="nombre" required></div>
          <div class="form-group"><label>Email</label><input type="email" name="email" required></div>
          <div class="form-group"><label>Contraseña</label><input type="password" name="password" required></div>
          <div class="form-group">
            <label>Rol</label>
            <select name="rol">
              <option value="aprendiz">Aprendiz</option>
              <option value="instructor">Instructor</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100" style="justify-content:center;">Crear</button>
        </form>
      </div>
    </div>

    <!-- MODAL EDITAR -->
    <div id="modal-editar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:200;align-items:center;justify-content:center;">
      <div class="card" style="width:480px;">
        <div class="flex-between mb-16">
          <div class="card-title" style="border:none;padding:0;margin:0">Editar usuario</div>
          <button class="btn btn-sm btn-ghost" onclick="document.getElementById('modal-editar').style.display='none'">✕</button>
        </div>
        <form id="form-editar" method="POST">
          <div class="form-group"><label>Nombre</label><input name="nombre" id="edit-nombre" required></div>
          <div class="form-group"><label>Email</label><input type="email" name="email" id="edit-email" required></div>
          <div class="form-group">
            <label>Rol</label>
            <select name="rol" id="edit-rol">
              <option value="aprendiz">Aprendiz</option>
              <option value="instructor">Instructor</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div class="form-group">
            <label>Estado (aprendices)</label>
            <select name="estado" id="edit-estado">
              <option value="Activo">Activo</option>
              <option value="Certificado">Certificado</option>
              <option value="Inactivo">Inactivo</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100" style="justify-content:center;">Guardar</button>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
function editarUsuario(u) {
  document.getElementById('edit-nombre').value = u.nombre;
  document.getElementById('edit-email').value = u.email;
  document.getElementById('edit-rol').value = u.rol;
  document.getElementById('edit-estado').value = u.estado || 'Activo';
  document.getElementById('form-editar').action = '/admin/usuarios/' + u._id + '/editar';
  document.getElementById('modal-editar').style.display = 'flex';
}
</script>
</body>
</html>
