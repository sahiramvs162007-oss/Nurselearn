<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %> — NurseLearn</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .raps-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; max-height: 200px; overflow-y: auto; padding: 8px; border: 1px solid var(--gris-borde); border-radius: 8px; }
    .rap-check { display: flex; align-items: flex-start; gap: 6px; font-size: 0.8rem; }
    .ficha-box { border: 1px solid var(--gris-borde); border-radius: 10px; margin-bottom: 20px; background: white; }
    .ficha-header { background: var(--azul); color: white; padding: 12px 20px; border-radius: 10px 10px 0 0; font-weight: 600; }
    .ficha-body { padding: 20px; }
    .badge-instructor { background: var(--verde-claro); color: var(--verde-oscuro); }
  </style>
</head>
<body>
<div class="layout">
  <!-- SIDEBAR -->
  <nav class="sidebar">
    <% locals.currentPath = '/admin/asignaciones'; %>
    <%- include('../partials/sidebar', { session: { userRol: 'admin' } }) %>
  </nav>

  <!-- TOPBAR -->
  <%- include('../partials/topbar', { user: user, userRol: 'Administrador' }) %>

  <!-- MAIN -->
  <main class="main">
    <div class="page-header">
      <h1 class="page-title">Asignaciones de Usuarios a Fichas</h1>
      <p class="page-subtitle">Vincula a los docentes con sus cursos y RAPs a impartir, y matricula a los aprendices en sus respectivas fichas.</p>
    </div>

    <% if (error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>
    <% if (success && success.length) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>

    <div class="grid-2">
      <!-- VINCULAR INSTRUCTOR -->
      <div class="card">
        <div class="card-title" style="border-bottom-color: var(--azul);">Asignar Docente / Instructor</div>
        <form action="/admin/asignaciones/instructor" method="POST">
          <div class="form-group">
            <label>Ficha (Curso)</label>
            <select name="fichaId" required>
              <option value="">— Seleccionar Ficha —</option>
              <% fichas.forEach(f => { %>
                <option value="<%= f._id %>"><%= f.codigo %> - <%= f.nombre %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Instructor</label>
            <select name="instructorId" required>
              <option value="">— Seleccionar Instructor —</option>
              <% instructores.forEach(i => { %>
                <option value="<%= i._id %>"><%= i.nombre %> (<%= i.email %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>RAPs que impartirá en esta ficha</label>
            <div class="raps-grid">
              <% raps.forEach(r => { %>
                <label class="rap-check">
                  <input type="checkbox" name="raps" value="<%= r._id %>">
                  <span><strong><%= r.modulo ? r.modulo.nombre : 'Sin módulo' %>:</strong> <br> <%= r.nombre %></span>
                </label>
              <% }) %>
            </div>
            <p class="text-muted" style="margin-top:6px; font-size:0.75rem;">Si el instructor ya está asignado a la ficha, esta acción sobrescribirá sus RAPs asignados.</p>
          </div>
          <button type="submit" class="btn btn-secondary mt-12 w-100">Asignar Instructor</button>
        </form>
      </div>

      <!-- MATRICULAR APRENDIZ -->
      <div class="card">
        <div class="card-title">Matricular Aprendiz</div>
        <form action="/admin/asignaciones/aprendiz" method="POST">
          <div class="form-group">
            <label>Ficha (Curso)</label>
            <select name="fichaId" required>
              <option value="">— Seleccionar Ficha —</option>
              <% fichas.forEach(f => { %>
                <option value="<%= f._id %>"><%= f.codigo %> - <%= f.nombre %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Aprendiz</label>
            <select name="aprendizId" required>
              <option value="">— Seleccionar Aprendiz —</option>
              <% aprendices.forEach(a => { %>
                <option value="<%= a._id %>"><%= a.nombre %> (<%= a.email %>)</option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary mt-12 w-100">Matricular Aprendiz</button>
        </form>
      </div>
    </div>

    <!-- VISTA DE FICHAS ACTUALES -->
    <h2 class="page-title" style="margin-top: 36px; margin-bottom: 20px;">Estado Actual de las Fichas</h2>
    <% if (fichas.length === 0) { %>
      <div class="alert alert-info">Crea fichas primero para ver su estado aquí.</div>
    <% } else { %>
      <div class="grid-2">
        <% fichas.forEach(f => { %>
          <div class="ficha-box">
            <div class="ficha-header flex-between">
              <span><%= f.codigo %></span>
              <span style="font-size: 0.85rem; font-weight: 400;"><%= f.nombre %></span>
            </div>
            <div class="ficha-body">
              
              <!-- INSTRUCTORES EN LA FICHA -->
              <h4 style="color:var(--azul); margin-bottom: 8px; font-size: 0.9rem;">👨‍🏫 Instructores Asignados</h4>
              <% if (f.instructores.length === 0) { %>
                <p class="text-muted mb-16">No hay instructores asignados.</p>
              <% } else { %>
                <ul style="list-style:none; margin-bottom: 16px;">
                  <% f.instructores.forEach(instObj => { 
                    const prof = instObj.instructor; 
                    if (prof) { %>
                    <li style="margin-bottom: 6px; font-size: 0.85rem;">
                      <span class="badge badge-instructor"><%= prof.nombre %></span> 
                      <span class="text-muted">— <%= instObj.raps.length %> RAPs asignados</span>
                    </li>
                  <% }}) %>
                </ul>
              <% } %>

              <!-- APRENDICES MATRICULADOS -->
              <h4 style="color:var(--azul); margin-bottom: 8px; font-size: 0.9rem; border-top:1px solid var(--gris-borde); padding-top: 12px;">🎓 Aprendices Matriculados (<%= f.aprendices.length %>)</h4>
              <% if (f.aprendices.length === 0) { %>
                <p class="text-muted">No hay aprendices matriculados.</p>
              <% } else { %>
                <div style="max-height: 150px; overflow-y: auto; border: 1px solid var(--gris-borde); border-radius: 6px; padding: 6px;">
                  <% f.aprendices.forEach(ap => { %>
                    <div class="flex-between" style="padding: 4px; border-bottom: 1px solid #eee;">
                      <span style="font-size: 0.8rem;"><%= ap.nombre %></span>
                      <form action="/admin/asignaciones/desasignar" method="POST" onsubmit="return confirm('¿Desmatricular a este aprendiz de la ficha?');">
                        <input type="hidden" name="fichaId" value="<%= f._id %>">
                        <input type="hidden" name="aprendizId" value="<%= ap._id %>">
                        <button type="submit" class="btn btn-sm" style="color:var(--rojo); background:transparent; padding:0;">✖</button>
                      </form>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
</body>
</html>
